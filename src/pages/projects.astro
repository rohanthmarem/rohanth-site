---
import { getCollection } from "astro:content";
import ContentLayout from "../layouts/ContentLayout.astro";

const allProjects = await getCollection("projects");
allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmtDate(d: Date) {
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

<ContentLayout title="projects | rohanth marem" description="Projects and experiments by Rohanth.">
  <section class="tbc-hero tbc-fu tbc-d2">
    <h1 class="tbc-hero-text">projects</h1>
    <div class="tbc-hero-meta">
      <span class="tbc-label">Things I've built</span>
      <span class="tbc-label">Code · hardware · tools</span>
    </div>
  </section>

  <section class="tbc-section tbc-fu tbc-d3" style="padding-bottom: 64px">
    <div class="tbc-project-list">
      {allProjects.map((project) => (
        <a
          href={project.data.link ?? `/projects/${project.id}`}
          class="tbc-project-card tbc-project-card--link"
          {...(project.data.link ? { target: "_blank", rel: "noopener" } : {})}
        >
          <div class="tbc-project-body">
            <div class="tbc-project-meta">
              {project.data.tags?.[0] && (
                <span class="tbc-project-tag">{project.data.tags[0]}</span>
              )}
              <span class="tbc-project-date">{fmtDate(project.data.date)}</span>
            </div>
            <p class="tbc-project-title">{project.data.title}</p>
            <p class="tbc-project-subtitle">{project.data.description}</p>
          </div>
          <div class="tbc-project-img-wrap">
            {project.data.image && (
              <img src={project.data.image} class="tbc-project-img" alt="" loading="lazy" />
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</ContentLayout>
