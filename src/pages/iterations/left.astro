---
// Render the real homepage: copy, artwork, project order and links stay in sync.
import Home from "../index.astro";
---

<Home noindex bodyId="left-study" />

<style is:global>
  /* This stylesheet belongs only to /iterations/left/. */
  #left-study .frame{
    display: block;
    max-width: none;
    min-height: 0;
    padding: 0 clamp(24px, 7.4vw, 108px);
  }
  #left-study .lines{ display: none; }
  #left-study .content{
    display: block;
    padding: 116px 0 76px;
  }
  #left-study .hero{ max-width: 680px; }
  #left-study .hero h1{ font-size: 32px; }
  #left-study .hero .tagline{ font-size: 23px; margin-top: 21px; }
  #left-study .jots{ margin-top: 28px; max-width: 660px; }
  #left-study .jots li{ font-size: 16px; line-height: 1.7; padding-top: 7px; padding-bottom: 7px; }
  #left-study .hero .reach{ margin-top: 24px; }

  #left-study .side{
    position: absolute;
    top: 36px;
    right: clamp(24px, 7.4vw, 108px);
    z-index: 8;
  }
  #left-study .side-inner,
  #left-study .side-inner.is-parked{
    position: static !important;
    margin: 0;
    padding: 0;
    max-height: none;
    overflow: visible;
    opacity: 1 !important;
    filter: none !important;
    transform: none !important;
    pointer-events: auto;
    animation: none;
    transition: none;
  }
  #left-study .side-nav, #left-study .side-extra{ display: none; }
  #left-study .side-menu{ display: block; position: relative; }
  #left-study .side-menu summary{
    list-style: none;
    display: grid;
    place-items: center;
    min-width: 64px;
    min-height: 40px;
    padding: 10px 14px;
    font: 13px/1 var(--mono);
    border: 1px solid var(--rule-strong);
    box-shadow: none;
    background: var(--paper);
    cursor: pointer;
  }
  #left-study .side-menu summary::-webkit-details-marker{ display: none; }
  #left-study .side-menu[open] summary{ background: var(--ink); color: var(--paper); }
  #left-study .side-menu ul{
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: 170px;
    padding: 8px 0;
    background: var(--surface);
    box-shadow: var(--shadow-border-hover);
  }
  #left-study .side-menu a{ display: block; padding: 12px 16px; font: 13px/1.4 var(--mono); }
  #left-study .side-menu a:hover{ color: var(--accent); }
  #left-study .side-menu a[aria-current="page"]{ color: var(--accent); }
  #left-study .projects{
    --edge-r: clamp(24px, 7.4vw, 108px);
    margin: 52px calc(-1 * var(--edge-r)) 0 0;
    padding-top: 0;
  }
  #left-study .rail{ grid-auto-columns: clamp(300px, 33vw, 480px); gap: 20px; }
  #left-study .phead{ margin-bottom: 20px; }
  #left-study .card h3{ margin-top: 15px; }
  @media (max-width: 700px) {
    #left-study .content{ padding-top: 112px; }
    #left-study .hero h1{ font-size: 28px; }
    #left-study .hero .tagline{ font-size: 18px; line-height: 1.6; margin-top: 16px; }
    #left-study .jots{ margin-top: 22px; }
    #left-study .jots li{ font-size: 15px; line-height: 1.7; padding-left: 18px; }
    #left-study .side{ top: 25px; }
    #left-study .projects{ margin-top: 40px; }
    #left-study .rail{ grid-auto-columns: 82vw; gap: 14px; }
  }
</style>
