---
import Base from "../layouts/Base.astro";
import Notebook from "../components/Notebook.astro";
import WaveBackground from "../components/WaveBackground.astro";
import NotebookOpen from "../components/NotebookOpen.astro";
import ModeToggle from "../components/ModeToggle.astro";
import { links, nav } from "../data/site";

const { noindex = false, bodyId } = Astro.props;
---

<Base current="home" description="rohanth marem — cs at waterloo. i like to sidequest." noindex={noindex} bodyId={bodyId} bare horizon>
  <WaveBackground />
  <div class="home">
    <section class="hero" aria-label="about">
      <h1 data-enter style="--stagger:0">rohanth marem</h1>
      <p class="tagline" data-enter style="--stagger:1">cs @ waterloo<br /><a href="/#sidequests" data-nbo-open="sidequests"><span class="u u-in-out">i like to sidequest.</span></a></p>

      <ul class="jots" data-enter style="--stagger:2">
        <li>prev. eng at <a class="org" href="https://www.phoebe.work" target="_blank" rel="noopener"><svg class="logo" viewBox="0 0 16 16" aria-hidden="true"><path fill="#5533EE" class="phoebe" d="M11.4287 0C13.9533 0 16 2.04668 16 4.57129C16 5.9367 15.4013 7.16235 14.4521 8C15.4013 8.83765 16 10.0633 16 11.4287C16 13.9533 13.9533 16 11.4287 16C10.0633 16 8.83765 15.4013 8 14.4521C7.16235 15.4013 5.9367 16 4.57129 16C2.04668 16 0 13.9533 0 11.4287C0 10.0633 .598733 8.83765 1.54785 8C.598723 7.16235 0 5.93671 0 4.57129C0 2.04667 2.04667 0 4.57129 0C5.93671 0 7.16235 .598723 8 1.54785C8.83765 .598733 10.0633 0 11.4287 0ZM10.4131 3.04785C9.28765 3.04788 8.33326 3.78002 8 4.79395C7.66673 3.78001 6.71237 3.04785 5.58691 3.04785C4.18455 3.04807 3.04798 4.18453 3.04785 5.58691C3.04787 6.71235 3.78003 7.66673 4.79395 8C3.78014 8.33324 3.04802 9.28683 3.04785 10.4121C3.04785 11.8146 4.18447 12.9519 5.58691 12.9521C6.71235 12.9521 7.66672 12.22 8 11.2061C8.33328 12.2199 9.28767 12.9521 10.4131 12.9521C11.8155 12.9519 12.9521 11.8146 12.9521 10.4121C12.952 9.2868 12.2199 8.33321 11.2061 8C12.2201 7.66679 12.9521 6.71242 12.9521 5.58691C12.952 4.18455 11.8154 3.04809 10.4131 3.04785ZM8 6.06934C9.06599 6.06934 9.92969 6.93401 9.92969 8C9.9296 9.06592 9.06594 9.92969 8 9.92969C6.93406 9.92968 6.0704 9.06592 6.07031 8C6.07031 6.93401 6.93401 6.06934 8 6.06934Z"/></svg><span class="u u-in-out">phoebe</span></a> ($9m seed) — built the agent layer for home healthcare scheduling + back-office work; youngest employee</li>
        <li>prev. swe at <a class="org" href="https://extrian.com" target="_blank" rel="noopener"><svg class="logo" viewBox="0 0 160 106" aria-hidden="true"><path d="M14 62C70 57 110 42 146 18" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round"/><line x1="14" y1="80" x2="146" y2="80" stroke="currentColor" stroke-width="14" stroke-linecap="round"/></svg><span class="u u-in-out">extrian</span></a> — scaled voice data collection platform for 10k users</li>
        <li>built (and crashed) autonomous drones to predict soil organic carbon content for town/provincial parks, backed by bloomberg philanthropies</li>
        <li>won <a href="https://hackthenorth.com" target="_blank" rel="noopener"><span class="u u-in-out">@hackthenorth</span></a> by building a mortal kombat replica that coaches you while you fight</li>
      </ul>

      <p class="reach" data-enter style="--stagger:3">reach out to me on <a href={links.x} target="_blank" rel="noopener"><span class="u u-in-out">X</span></a>, <a href={links.linkedin} target="_blank" rel="noopener"><span class="u u-in-out">LinkedIn</span></a> or via <a href={links.email}><span class="u u-in-out">email</span></a></p>

      <nav class="pages" aria-label="Primary" data-enter style="--stagger:4">
        {nav.map(({ key, href }) => <a href={href}><span class="u u-in-out">{key}</span></a>)}
        <ModeToggle class="mode" />
      </nav>
    </section>

    <div class="cover" data-enter style="--stagger:2"><Notebook /></div>
  </div>
  <NotebookOpen />
</Base>

<style>
  .home {
    --pad-y: clamp(24px, 4vh, 48px);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(40px, 6vw, 104px);
    max-width: 1360px; min-height: 100svh; margin: 0 auto; padding: var(--pad-y) var(--page-pad);
  }
  /* the cover is as tall as the window allows, leaving room for its caption */
  .cover { width: min(calc((100svh - 2 * var(--pad-y) - 76px) * 1268 / 1834), 48vw, 620px); }
  .hero h1 { font: var(--title); }
  .hero .tagline { margin: 12px 0 0; font: 400 19px/1.45 var(--serif); }
  .jots { list-style: none; margin: 26px 0 0; padding: 0; max-width: 62ch; }
  .jots li { position: relative; padding: 7px 0 7px 22px; font: 300 16px/1.6 var(--serif); }
  .jots li::before { content: ""; position: absolute; left: 2px; top: 1.05em; width: 6px; height: 6px; background: var(--ink-3); }
  .hero .reach { margin: 22px 0 0; font: 300 15px/1.7 var(--serif); color: var(--ink-2); }
  .hero a { color: var(--ink); }
  .org { white-space: nowrap; font-weight: 400; }
  /* links in the jots keep a faint underline at rest, so they read as links; the ink one draws over it on hover */
  .jots a .u::before { display: block; opacity: 0.25; }
  .org .logo { display: inline-block; width: 0.95em; height: 0.95em; margin: 0 0.3em 0 0.08em; vertical-align: -0.12em; object-fit: contain; }
  .pages { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-top: 28px; font: 14px/1.45 var(--mono); }
  .pages a { padding: 4px 0; }
  .pages :global(.mode) { margin: -2px -7px 0 auto; color: var(--ink-3); }
  @media (max-width: 899px) {
    .home { grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: start; padding-top: 40px; padding-bottom: 32px; }
    .cover { width: 100%; max-width: 520px; margin: 0 auto; }
  }
</style>
