---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function fmtDate(d: Date) {
  return d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}
---

<ContentLayout title={`${entry.data.title} | rohanth marem`} description={entry.data.description}>
  <section class="tbc-hero tbc-fu tbc-d2">
    <div style="margin-bottom: 16px">
      <a href="/projects" class="tbc-text-link tbc-label">← Projects</a>
    </div>
    <h1 class="tbc-hero-text">{entry.data.title}</h1>
    <div class="tbc-hero-meta">
      <span class="tbc-label">{fmtDate(entry.data.date)}</span>
      {entry.data.tags?.map((tag) => <span class="tbc-label">{tag}</span>)}
    </div>
  </section>

  <article class="tbc-section tbc-prose" style="padding-bottom: 80px">
    <Content />
  </article>
</ContentLayout>
