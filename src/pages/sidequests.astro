---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { links } from "../data/site";
import runStart from "../assets/sidequests/run-start.webp";
import runRace from "../assets/sidequests/run-race.webp";
import bikeTrail from "../assets/sidequests/bike-trail.webp";
import foodKatsu from "../assets/sidequests/food-katsu.webp";
import foodIndian from "../assets/sidequests/food-indian.webp";
import foodBrunch from "../assets/sidequests/food-brunch.webp";
import foodDinner from "../assets/sidequests/food-dinner.webp";
import foodUdon from "../assets/sidequests/food-udon.webp";
import photoDumbo from "../assets/sidequests/photo-dumbo.webp";
import photoWindow from "../assets/sidequests/photo-window.webp";
import photoConcert from "../assets/sidequests/photo-concert.webp";
import photoSf from "../assets/sidequests/photo-sf.webp";
import wingsFilm from "../assets/sidequests/wings-film.webp";
import wingsBww from "../assets/sidequests/wings-bww.webp";
import karateReady from "../assets/sidequests/karate-ready.webp";
import karateJump from "../assets/sidequests/karate-jump.webp";

// strip images: `w` is a relative column width (≈ display height × aspect ratio), so the row
// keeps mixed heights without cropping and scales with the page.
const food = [
  { src: foodKatsu, alt: "Overhead view of a table of katsu plates, chopsticks and orange slices", cap: "katsu", w: 26 },
  { src: foodIndian, alt: "An indian dinner spread with naan, curries and rice, a friend making peace signs behind it", cap: "indian", w: 35 },
  { src: foodBrunch, alt: "A brunch table with egg bowls, roast potatoes and glasses of juice", cap: "brunch", w: 29 },
  { src: foodDinner, alt: "A group of friends eating dinner around a long restaurant table", cap: "group dinner", w: 38 },
  { src: foodUdon, alt: "A tray with udon and a plate of japanese curry rice at a busy counter", cap: "udon + curry", w: 32 },
];
const photos = [
  { src: photoDumbo, alt: "The Manhattan Bridge framed between brick buildings on a crowded street in Dumbo", cap: "dumbo", w: 33 },
  { src: photoWindow, alt: "The New York skyline at dusk, seen through a car window", cap: "nyc, through the window", w: 40 },
  { src: photoConcert, alt: "An arena concert from the upper seats, the stage lit orange", cap: "concert", w: 28 },
  { src: photoSf, alt: "Three friends sitting arm in arm on a San Francisco street, looking out at the skyline", cap: "sf", w: 34 },
];

// Responsive sources for a strip image. Phones/tablets show the strip as a scroller at a fixed
// height (240px / 300px, see the styles below), so the slot is height × aspect; desktop shows it as a
// grid row whose column is a share (w / total) of the full-width section, which is
// min(100vw, 1360px) minus the page padding (min(4vw, 64px) per side) and the gaps.
// widths cover 1–3× of each slot, never beyond the source file.
type StripImg = { src: ImageMetadata; w: number };
const stripImage = (img: StripImg, row: StripImg[], gap: number) => {
  const aspect = img.src.width / img.src.height;
  const share = img.w / row.reduce((sum, r) => sum + r.w, 0);
  const gaps = gap * (row.length - 1);
  const phone = Math.round(240 * aspect);
  const tablet = Math.round(300 * aspect);
  const desktop = Math.round((1360 - 128 - gaps) * share); // widest desktop column (≥1600px)
  const want = [phone, phone * 2, phone * 3, tablet, tablet * 2, desktop, desktop * 2]
    .map((x) => Math.min(img.src.width, Math.ceil(x / 20) * 20))
    .sort((a, b) => a - b);
  // drop candidates within ~10% of the next one up: the bigger file covers both
  const widths = want.filter((x, i) => i === want.length - 1 || want[i + 1] > x * 1.1);
  const f = share.toFixed(4);
  const sizes = [
    `(max-width: 640px) ${phone}px`,
    `(max-width: 1023px) ${tablet}px`,
    `(max-width: 1359px) calc((92vw - ${gaps}px) * ${f})`,
    `(max-width: 1599px) calc((1360px - 8vw - ${gaps}px) * ${f})`,
    `${desktop}px`,
  ].join(", ");
  return { widths, sizes };
};
---

<Base
  title="sidequests"
  description="things i do for fun, or just because — running, food, photos, airport wings and karate."
  current="sidequests"
>
  <header class="page-head sidequests-head">
    <h1>sidequests</h1>
    <p>things i do for fun, or just because. lately that means running further than i should, eating things i've never tried, and shooting film i can't really afford. plus airport wings, and a decade of karate.</p>
  </header>

  <section class="entry first" aria-labelledby="running-title">
    <h2 id="running-title">speedrunning a quarter-life crisis</h2>
    <p>i have ran (edit: <a href={links.strava2} target="_blank" rel="noopener noreferrer">two</a>) <a href={links.strava} target="_blank" rel="noopener noreferrer">half-marathons</a> and now i have an unreasonably ambitious desire to become an ironman by 21.</p>
  </section>

  <figure class="wide feature">
    <Image src={runStart} alt="Runners crossing under the Oakville 21.1 start / finish arch" widths={[640, 960, 1280]} sizes="(max-width: 500px) calc(100vw - 40px), (max-width: 1023px) 92vw, 640px" loading="eager" fetchpriority="high" decoding="async" />
    <figcaption>oakville 21.1</figcaption>
  </figure>

  <div class="wide duo run-duo">
    <figure>
      <Image src={runRace} alt="Runners in black mid-race on a tree-lined street during a half marathon" widths={[480, 720, 960, 1280]} sizes="(max-width: 500px) calc((100vw - 50px) * 2 / 3), (max-width: 640px) calc((92vw - 10px) * 2 / 3), (max-width: 1023px) calc((92vw - 14px) * 2 / 3), 630px" loading="lazy" decoding="async" />
      <figcaption>mid-race</figcaption>
    </figure>
    <figure>
      <Image src={bikeTrail} alt="View over a road bike's handlebars down a paved forest trail" widths={[240, 320, 480, 640]} sizes="(max-width: 500px) calc((100vw - 50px) / 3), (max-width: 640px) calc((92vw - 10px) / 3), (max-width: 1023px) calc((92vw - 14px) / 3), 315px" loading="lazy" decoding="async" />
      <figcaption>on the bike</figcaption>
    </figure>
  </div>

  <section class="entry" aria-labelledby="food-title">
    <h2 id="food-title">living to eat instead of eating to live</h2>
    <p>i've always been the opposite of a picky eater, satisfied with whatever slop i could make. now i'm <a href={links.beli} target="_blank" rel="noopener noreferrer">trying new foods</a> and cooking real food.</p>
  </section>

  <div class="span strip food-strip" style={`--cols: ${food.map((f) => `${f.w}fr`).join(" ")}`} role="region" aria-label="food photos" tabindex="0">
    {food.map((f) => (
      <figure>
        <Image src={f.src} alt={f.alt} {...stripImage(f, food, 14)} loading="lazy" decoding="async" />
        <figcaption>{f.cap}</figcaption>
      </figure>
    ))}
  </div>

  <section class="entry" aria-labelledby="karate-title">
    <h2 id="karate-title">karate</h2>
    <p>i've trained karate for 10+ years, and i'm currently a 2nd degree black belt.</p>
  </section>

  <div class="wide karate-set">
    <div class="karate-pair">
      <Image src={karateReady} alt="Rohanth in a white gi and blue belt standing ready at a national tournament, a Canada banner behind him" widths={[320, 480, 640]} sizes="(max-width: 1023px) 50vw, 314px" loading="lazy" decoding="async" />
      <Image src={karateJump} alt="Rohanth mid-air during a jumping kata at a tournament, judges seated behind him" widths={[320, 480, 640]} sizes="(max-width: 1023px) 50vw, 314px" loading="lazy" decoding="async" />
    </div>
    <p class="karate-cap">nationals 2026<br />10+ years, 2nd degree black belt.</p>
  </div>

  <section class="entry" aria-labelledby="photos-title">
    <h2 id="photos-title">taking more photos</h2>
    <p>i don't take enough photos. i've been dabbling with film and i love it, but it's so expensive.</p>
  </section>

  <div class="span strip photo-strip" style={`--cols: ${photos.map((p) => `${p.w}fr`).join(" ")}`} role="region" aria-label="photos" tabindex="0">
    {photos.map((p) => (
      <figure>
        <Image src={p.src} alt={p.alt} {...stripImage(p, photos, 18)} loading="lazy" decoding="async" />
        <figcaption>{p.cap}</figcaption>
      </figure>
    ))}
  </div>

  <section class="entry" aria-labelledby="wings-title">
    <h2 id="wings-title">buffalo wild wings</h2>
    <p>i'm trying wings at every airport buffalo wild wings in the usa. so far: MSP, DFW, and ATL. always the wings with blazin' sauce.</p>
  </section>

  <div class="wide wings-set">
    <figure>
      <Image src={wingsFilm} alt="Film photo of Rohanth biting into a wing at the DFW airport Buffalo Wild Wings" widths={[640, 960, 1280]} sizes="(max-width: 1023px) 100vw, 640px" loading="lazy" decoding="async" />
      <figcaption>DFW, on film</figcaption>
    </figure>
    <figure>
      <Image src={wingsBww} alt="Rohanth at the MSP airport Buffalo Wild Wings behind a basket of wings with ranch" widths={[320, 480, 720]} sizes="(max-width: 640px) 70vw, (max-width: 1023px) 50vw, 280px" loading="lazy" decoding="async" />
      <figcaption>MSP</figcaption>
    </figure>
  </div>
</Base>

<script>
  // the strips are keyboard scrollers (arrow keys, once focused) only where they scroll; as a
  // static desktop grid they'd be an empty tab stop, so drop it there
  for (const strip of document.querySelectorAll<HTMLElement>(".strip")) {
    const sync = () => {
      if (strip.scrollWidth > strip.clientWidth + 1) strip.tabIndex = 0;
      else if (document.activeElement !== strip) strip.removeAttribute("tabindex");
    };
    new ResizeObserver(sync).observe(strip);
  }
</script>

<style>
  .sidequests-head { padding-top: 0; padding-bottom: 0; }
  .sidequests-head p { max-width: 44ch; margin-top: 24px; }

  .entry { margin-top: clamp(48px, 5vw, 72px); }
  .entry.first { margin-top: clamp(56px, 6vw, 88px); }
  .entry h2 { font: 400 clamp(20px, 2vw, 22px)/1.45 var(--serif); letter-spacing: -0.012em; }
  .entry p { max-width: 58ch; margin: 13px 0 0; color: var(--ink-2); font: 300 16px/1.85 var(--serif); }
  .entry a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: 4px; transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out); }
  .entry a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  figure { margin: 0; }
  figure :global(img), .karate-pair :global(img) { display: block; width: 100%; height: auto; background: var(--paper-2); }
  figcaption, .karate-cap { color: var(--ink-3); font: 11px/1.55 var(--mono); }
  figcaption { margin-top: 9px; }

  /* image in the reading column, caption in the right margin */
  .feature { display: grid; grid-template-columns: minmax(0, var(--main-w)) minmax(0, 1fr); align-items: start; margin-top: clamp(34px, 4vw, 52px); }
  .feature figcaption { margin: 0; padding: 2px 24px 0; font-size: 12px; }

  /* landscape + portrait at one height: columns proportional to aspect ratio */
  .duo { display: grid; gap: 14px; align-items: start; margin-top: 14px; }
  .run-duo { grid-template-columns: 1.5fr 0.75fr; }
  .run-duo figure:first-child :global(img) { aspect-ratio: 3 / 2; object-fit: cover; }
  .run-duo figure:last-child :global(img) { aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 70%; }

  /* full-width rows, mixed heights */
  .strip { display: grid; grid-template-columns: var(--cols); gap: 14px; margin-top: clamp(44px, 5vw, 64px); }
  .food-strip { align-items: end; }
  .photo-strip { align-items: start; gap: 18px; }
  .photo-strip figure:nth-child(2) { margin-top: 72px; }
  .photo-strip figure:nth-child(3) { margin-top: 28px; }
  .photo-strip figure:nth-child(4) { margin-top: 40px; }

  /* landscape film shot in the column, the bww portrait in the margin */
  .wings-set { display: grid; grid-template-columns: minmax(0, var(--main-w)) minmax(220px, 1fr); align-items: start; margin-top: clamp(34px, 4vw, 52px); }
  .wings-set figure:last-child { padding-left: 24px; max-width: 304px; margin-top: 96px; }

  .karate-set { display: grid; grid-template-columns: minmax(0, var(--main-w)) minmax(0, 1fr); align-items: end; margin-top: clamp(34px, 4vw, 52px); }
  .karate-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .karate-pair :global(img) { aspect-ratio: 3 / 4; object-fit: cover; }
  .karate-pair :global(img:last-child) { object-position: 50% 0%; }
  .karate-cap { margin: 0; padding: 0 24px 0; font-size: 12px; }

  /* narrow desktop: the margin is too thin for captions, so they drop under the images */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .feature, .karate-set { grid-template-columns: minmax(0, var(--main-w)); }
    .feature figcaption, .karate-cap { padding: 9px 0 0; font-size: 11px; }
  }
  @media (max-width: 1023px) {
    .feature, .wings-set, .karate-set { grid-template-columns: minmax(0, 1fr); }
    .feature figcaption, .karate-cap { padding: 9px 0 0; }
    .wings-set figure:last-child { padding-left: 0; margin: 28px 0 0 auto; width: 60%; max-width: none; }
    /* strips become horizontal scrollers at a shared height */
    /* edge to edge, snapping to the text column; overscroll stays in the strip (no back-swipe) */
    .strip { display: flex; gap: 10px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--page-pad); scrollbar-width: none; margin-inline: calc(-1 * var(--page-pad)); padding-inline: var(--page-pad); }
    .strip::-webkit-scrollbar { display: none; }
    /* the strip runs edge to edge, so the ring reads as a rule above and below it */
    .strip:focus-visible { outline-offset: 6px; }
    .strip figure { flex: none; scroll-snap-align: start; margin-top: 0 !important; }
    .strip :global(img) { height: 300px; width: auto; }
  }
  @media (max-width: 640px) {
    .sidequests-head p { margin-top: 18px; }
    .entry { margin-top: 44px; }
    .entry.first { margin-top: 52px; }
    .entry p { font-size: 15px; line-height: 1.8; }
    .feature, .wings-set, .karate-set { margin-top: 28px; }
    .duo { gap: 10px; margin-top: 10px; }
    .run-duo { grid-template-columns: 1.5fr 0.75fr; }
    .strip { margin-top: 32px; }
    .strip :global(img) { height: 240px; }
    .karate-pair { gap: 8px; }
    figcaption { font-size: 10px; margin-top: 7px; }
  }
</style>
