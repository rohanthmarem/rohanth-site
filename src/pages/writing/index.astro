---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fmtDot } from "../../lib/format";
import { links } from "../../data/site";

const posts = (await getCollection("writings")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
---

<Base title="writing" current="writing">
    <div class="page-head head">
      <h1 data-enter style="--stagger: 1">writing</h1>
      <a class="substack" href={links.substack} target="_blank" rel="noopener noreferrer" data-enter style="--stagger: 3">
        <span class="u u-in-out">also on substack ↗</span>
      </a>
    </div>

    <section id="writing-list" class="views wide" aria-label="Writing" data-enter style="--stagger: 4">
        {years.map((year) => {
          const yearPosts = posts.filter((post) => post.data.date.getUTCFullYear() === year);
          return <div class="year-group" data-year-group>
            <div class="year-label num">{year}</div>
            <ul>
              {yearPosts.map((post) => {
                return <li class="archive-row">
                  <div class="archive-copy">
                    <h2><a href={`/writing/${post.id}`}><span class="u u-in-out">{post.data.title}</span></a></h2>
                    <p>{post.data.description}</p>
                  </div>
                  <time class="archive-date num" datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDot(post.data.date)}</time>
                </li>;
              })}
            </ul>
          </div>;
        })}
    </section>
</Base>

<style>
  .head h1 { font: var(--title); }
  .substack { display: inline-flex; align-items: center; min-height: 40px; margin-top: 4px; font: 13px/1.4 var(--sans); color: var(--ink-2); transition: color var(--dur-fast) var(--ease-out); }
  .substack:hover { color: var(--ink); }
  .views { margin-top: 8px; max-width: 760px; }
  .year-group { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 18px 0; border-top: 1px solid var(--rule); }
  .year-group:first-child { padding-top: 0; border-top: 0; }
  .year-label { position: sticky; top: 24px; align-self: start; padding-top: 3px; font: 13px/1 var(--mono); color: var(--ink-3); }
  .year-group ul { list-style: none; margin: 0; padding: 0; }
  .archive-row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 20px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .archive-row:first-child { padding-top: 0; border-top: 0; }
  .archive-copy h2 { font: 300 18px/1.35 var(--serif); }
  .archive-copy p { margin: 3px 0 0; font: 300 14px/1.5 var(--serif); color: var(--ink-3); }
  .archive-copy a { display: inline-block; padding: 6px 0; margin: -6px 0; }
  /* the whole row (date too) is the link's hit area */
  .archive-copy a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .archive-copy a:focus-visible { outline: 0; }
  .archive-copy a:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 2px; }
  .archive-date { font: 12px/1 var(--mono); color: var(--ink-3); white-space: nowrap; transition: color var(--dur-fast) var(--ease-out); }
  .archive-row:is(:hover, :focus-within) .archive-date { color: var(--accent); }
  @media (max-width: 720px) {
    .year-group { grid-template-columns: 1fr; gap: 10px; }
    .year-label { position: static; }
  }
  @media (max-width: 520px) {
    .archive-row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
</style>
