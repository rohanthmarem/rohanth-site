---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import WritingArt from "../../components/WritingArt.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import CropMarks from "../../components/CropMarks.astro";
import { fmtDot } from "../../lib/format";
import { links } from "../../data/site";

// generated editorial covers (src/assets/writing/<post id>.webp); posts without one fall back to line art
const coverFiles = import.meta.glob<ImageMetadata>("../../assets/writing/*.webp", { eager: true, import: "default" });
const coverFor = (id: string) => coverFiles[`../../assets/writing/${id}.webp`];

const posts = (await getCollection("writings")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
const colorsById: Record<string, { bg: string; fg: string }> = {
  "conversations-with-a-younger-me": { bg: "var(--paper-2)", fg: "var(--ink)" },
  vibecodingsucks: { bg: "var(--ink)", fg: "var(--paper)" },
  "16from16": { bg: "var(--hl)", fg: "var(--ink)" },
};
const artFor = (id: string) => colorsById[id] ?? { bg: "var(--paper-2)", fg: "var(--ink)" };
---

<Base title="writing" current="writing">
    <div class="page-head head">
      <div class="head-copy">
        <h1 data-enter style="--stagger: 1">writing</h1>
        <a class="substack" href={links.substack} target="_blank" rel="noopener noreferrer" data-enter style="--stagger: 3">
          <span class="u u-in-out">also on substack ↗</span>
        </a>
      </div>
      <div class="view-switch" role="group" aria-label="Writing view" data-view-switch data-enter style="--stagger: 3">
        <button type="button" data-view="grid" aria-pressed="true" aria-controls="writing-grid">grid</button>
        <button type="button" data-view="list" aria-pressed="false" aria-controls="writing-list">list</button>
      </div>
    </div>

    <section id="writing-grid" class="views span" aria-label="Writing cards" data-enter style="--stagger: 4">
        <div class="grid" data-grid>
          {posts.map((post, i) => {
            const art = artFor(post.id);
            return <a class="card" href={`/writing/${post.id}`}>
              <div class="card-cover cv cropmarks img-outline">
                {coverFor(post.id) ? <Image src={coverFor(post.id)!} alt="" widths={[480, 800, 1200]} sizes="(max-width: 500px) calc(100vw - 40px), (max-width: 720px) 92vw, (max-width: 1023px) calc((92vw - 24px) / 2), 400px" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} class="cover-img" /> : <WritingArt id={post.id} fg={art.fg} bg={art.bg} />}
                <CropMarks />
              </div>
              <h2>{post.data.title}</h2>
              <div class="card-date"><time class="num" datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDot(post.data.date)}</time></div>
              <p>{post.data.description}</p>
            </a>;
          })}
        </div>
    </section>

    <section id="writing-list" class="views wide" aria-label="Writing list" hidden>
        {years.map((year) => {
          const yearPosts = posts.filter((post) => post.data.date.getUTCFullYear() === year);
          return <div class="year-group" data-year-group>
            <div class="year-label num">{year}<small>{yearPosts.length} {yearPosts.length === 1 ? "post" : "posts"}</small></div>
            <ul>
              {yearPosts.map((post) => {
                const art = artFor(post.id);
                return <li class="archive-row">
                  <div class="archive-copy">
                    <h2><a href={`/writing/${post.id}`}><span class="u u-in-out">{post.data.title}</span></a></h2>
                  </div>
                  <div class="archive-thumb cv cropmarks img-outline" aria-hidden="true">{coverFor(post.id) ? <Image src={coverFor(post.id)!} alt="" widths={[320, 640]} sizes="300px" class="cover-img" /> : <WritingArt id={post.id} fg={art.fg} bg={art.bg} />}<CropMarks /></div>
                  <time class="archive-date num" datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDot(post.data.date)}</time>
                </li>;
              })}
            </ul>
          </div>;
        })}
    </section>
  <div class="archive-peek" data-archive-peek aria-hidden="true"></div>
  <script>import "../../scripts/writing";</script>
</Base>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-top: 0; padding-bottom: 24px; border-bottom: 1px solid var(--rule); }
  .head h1 { font: var(--title); }
  .substack { display: inline-flex; align-items: center; min-height: 40px; margin-top: 4px; font: 12px/1.4 var(--mono); color: var(--ink-2); transition: color var(--dur-fast) var(--ease-out); }
  .substack:hover { color: var(--ink); }
  .view-switch { display: flex; gap: 20px; align-items: center; }
  .view-switch button { min-height: 40px; font: 500 13px/1 var(--mono); color: var(--ink-3); transition: color var(--dur-fast) var(--ease-out); }
  .view-switch button:hover { color: var(--ink); }
  .view-switch button[aria-pressed="true"] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .view-switch button:active { transform: scale(.97); }
  .views { margin-top: 44px; }
  .views[hidden] { display: none !important; }
  .views.is-switching { animation: view-in 360ms var(--ease-out) both; }
  @keyframes view-in { from { opacity: 0; transform: translateY(6px); } }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 24px; }
  .card { display: block; min-width: 0; transition: transform 520ms var(--ease-out-strong), opacity 360ms var(--ease-out); }
  .card:active { transform: scale(.985); }
  .cv { position: relative; overflow: hidden; background: var(--paper-2); }
  .card-cover { aspect-ratio: 16 / 9; }
  .cv :global(.cover-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out-strong); }
  .card:is(:hover, :focus-visible) .cv :global(.cover-img) { transform: scale(1.03); }
  .cv :global(.cover) { position: absolute; inset: 0; transition: transform 700ms var(--ease-out-strong); }
  .card:is(:hover, :focus-visible) .cv :global(.cover) { transform: scale(1.03); }
  .card h2 { margin-top: 16px; font: 300 22px/1.3 var(--serif); letter-spacing: -.004em; }
  .card-date { display: flex; gap: 10px; margin-top: 8px; font: 13px/1 var(--mono); color: var(--ink-3); }
  .card p { margin: 10px 0 0; font: 15px/1.55 var(--serif); color: var(--ink-2); }
  .year-group { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 24px; padding: 28px 0; border-top: 1px solid var(--rule); }
  .year-group:first-child { padding-top: 0; border-top: 0; }
  .year-label { position: sticky; top: 24px; align-self: start; font: 44px/1 var(--pixel); }
  .year-label small { display: block; margin-top: 10px; font: 12px/1 var(--mono); color: var(--ink-3); }
  .year-group ul { list-style: none; margin: 0; padding: 0; }
  .archive-row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 24px; padding: 16px 0; border-top: 1px solid var(--rule); }
  .archive-row:first-child { padding-top: 0; border-top: 0; }
  .archive-copy h2 { font: 300 26px/1.25 var(--serif); }
  .archive-copy a { display: inline-block; padding: 8px 0; margin: -8px 0; }
  /* the whole row (cover thumb and date too) is the link's hit area */
  .archive-copy a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .archive-copy a:focus-visible { outline: 0; }
  .archive-copy a:focus-visible::after { outline: 2px solid var(--accent); outline-offset: 2px; }
  .archive-date { font: 13px/1 var(--mono); color: var(--ink-3); white-space: nowrap; transition: color var(--dur-fast) var(--ease-out); }
  .archive-row:is(:hover, :focus-within) .archive-date { color: var(--accent); }
  .archive-thumb { display: none; aspect-ratio: 16 / 9; width: 92px; }
  .archive-peek { display: none; position: fixed; z-index: 50; width: 300px; aspect-ratio: 16 / 10; pointer-events: none; overflow: hidden; box-shadow: var(--shadow-border-hover); opacity: 0; transform: translate(-50%, -50%) scale(.92); filter: blur(6px); transition: opacity 240ms var(--ease-out), transform 360ms var(--ease-out-strong), filter 240ms var(--ease-out); }
  .archive-peek.is-on { opacity: 1; transform: translate(-50%, -50%) scale(1); filter: blur(0); }
  .archive-peek :global(.archive-thumb) { display: block; width: 100%; height: 100%; aspect-ratio: auto; }
  @media (hover: hover) and (pointer: fine) { .archive-peek { display: block; } }
  @media (hover: none), (pointer: coarse) { .archive-row { grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; } .archive-thumb { display: block; } }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) {
    .view-switch { gap: 16px; }
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .year-group { grid-template-columns: 1fr; gap: 12px; }
    .year-label { position: static; display: flex; align-items: baseline; gap: 12px; font-size: 32px; }
    .year-label small { margin: 0; }
    .archive-copy h2 { font-size: 22px; }
    .archive-thumb { display: block; }
    .archive-peek { display: none; }
  }
  @media (max-width: 520px) {
    .archive-row { grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
    .archive-date { grid-column: 1; grid-row: 2; }
    .archive-thumb { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
