---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Post from "../../layouts/Post.astro";
import ProseImage from "../../components/ProseImage.astro";
import Highlight from "../../components/Highlight.astro";
import Sidenote from "../../components/Sidenote.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("writings")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: entries[index - 1],
      next: entries[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<"writings">;
  previous?: CollectionEntry<"writings">;
  next?: CollectionEntry<"writings">;
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
const neighbor = (other?: CollectionEntry<"writings">) => other && ({
  title: other.data.title,
  date: other.data.date,
  href: `/writing/${other.id}`,
});
---

<Post entry={entry} kind="writing" headings={headings} previous={neighbor(previous)} next={neighbor(next)}>
  <Content components={{ img: ProseImage, Highlight, Sidenote }} />
</Post>
