---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { excerpt, fmtThoughtDate } from "../../thoughts";

export async function getStaticPaths() {
  const thoughts = await getCollection("thoughts");
  return thoughts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const summary = excerpt(entry.body ?? "", 150);
---

<ContentLayout title={`${entry.data.title ?? excerpt(entry.body ?? "", 60)} | rohanth marem`} description={summary}>
  <section class="tbc-hero tbc-fu tbc-d2">
    <div style="margin-bottom: 16px">
      <a href="/thoughts" class="tbc-text-link tbc-label">← Chain of thought</a>
    </div>
    {entry.data.title && <h1 class="tbc-hero-text">{entry.data.title}</h1>}
    <div class="tbc-hero-meta">
      <span class="tbc-label"><time datetime={entry.data.date.toISOString()}>{fmtThoughtDate(entry.data.date)}</time></span>
      {entry.data.tags?.map((tag) => <span class="tbc-label">{tag}</span>)}
    </div>
  </section>

  <article class="tbc-section tbc-prose" style="padding-top: 24px; padding-bottom: 80px">
    <Content />
  </article>
</ContentLayout>
