---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { execSync } from "node:child_process";

interface Props {
  title: string;
  description: string;
  source: "index.html" | "projects.html" | "writing.html" | "inspiration.html";
}

const {
  title,
  description,
  source,
} = Astro.props;

const sourceRoot = resolve(process.cwd(), "src/source");
const rawCss = readFileSync(resolve(sourceRoot, "styles.css"), "utf8");
const sourceHtml = readFileSync(resolve(sourceRoot, source), "utf8");
const cobaltVars = rawCss.match(/html\[data-orange="cobalt"\]\s*{([\s\S]*?)\n}/)?.[1] ?? "";
const css = rawCss
  .replace(/\s*\/\* Default palette: ember \(#EA580C\) — toggle “Rust” for terracotta \*\/\n/, "\n")
  .replace(/html\[data-orange="rust"\]\s*{[\s\S]*?\n}\n\n/, "")
  .replace(/html\[data-orange="cobalt"\]\s*{[\s\S]*?\n}\n\n/, "")
  .replace(/\/\* ── Dev: orange palette toggle[\s\S]*$/, "")
  .replace(/:root\s*{([\s\S]*?)\n}/, (_match, vars) => `:root {${vars}\n${cobaltVars}\n}`);

let lastUpdatedDate = "";
let lastUpdatedUrl = "https://github.com/rohanthmarem/rohanth-site";
try {
  const hash = execSync("git log -1 --format=%H").toString().trim();
  const raw = execSync('git log -1 --format=%cd --date=format:"%b %d, %Y"').toString().trim();
  lastUpdatedDate = raw;
  lastUpdatedUrl = `https://github.com/rohanthmarem/rohanth-site/commit/${hash}`;
} catch {
  lastUpdatedDate = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
}

const body = sourceHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? "";
const brandedBody = body
  .replaceAll('aria-label="teenbuildersclub home"', 'aria-label="rohanth home"')
  .replaceAll('<span class="tbc-logo-mark">tbc</span>', '<span class="tbc-logo-mark">rohanth</span>')
  .replaceAll('<span class="tbc-logo-mark tbc-logo-mark--footer">tbc</span>', '<span class="tbc-logo-mark tbc-logo-mark--footer">rohanth</span>')
.replaceAll("Teen Builders Club", "rohanth")
  .replaceAll("teen builders club", "rohanth")
  .replaceAll("teen builders", "builders")
  .replaceAll("How TBC changed the way I think about accountability.", "How building in public changed the way I think about accountability.")
  .replaceAll("— rohanth", "- rohanth")
  .replaceAll("hello@teenbuilders.club", "hello@rohanth.com")
  .replaceAll("https://www.teenbuilders.club/events", "/projects/")
  .replaceAll("https://www.teenbuilders.club/photos/workshop.jpg", "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80")
  .replaceAll("https://www.teenbuilders.club/photos/hackathon.jpg", "https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80")
  .replaceAll("https://twitter.com/shayaan_azeem", "https://twitter.com/rohanthmarem")
  .replaceAll("https://twitter.com/shayaan", "https://twitter.com/rohanthmarem")
  .replace(/<div\s+class="tbc-orange-toggle"[\s\S]*?<\/script>\s*$/i, "")
  .replaceAll("LAST_UPDATED_DATE", lastUpdatedDate)
  .replaceAll("LAST_UPDATED_URL", lastUpdatedUrl);

const navGridScript = `<script>(function(){var n=document.querySelector('.tbc-nav');if(!n)return;var O=5000;n.addEventListener('mousemove',function(e){var r=n.getBoundingClientRect();n.style.setProperty('--grid-vx',(e.clientX-r.left+O)+'px');n.style.setProperty('--grid-vy',(e.clientY-r.top)+'px');n.style.setProperty('--grid-op','1')});n.addEventListener('mouseleave',function(){n.style.setProperty('--grid-op','0')})})();<\/script>`;
---

<!doctype html>
<html lang="en" data-orange="cobalt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7e8da" />
    <title>{title}</title>
    <style is:global set:html={css}></style>
  </head>
  <body set:html={brandedBody + navGridScript}>
  </body>
  <script>import "../colorShuffle.ts"</script>
</html>
