---
import Analytics from "@vercel/analytics/astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { execSync } from "node:child_process";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;

const sourceRoot = resolve(process.cwd(), "src/source");
const rawCss = readFileSync(resolve(sourceRoot, "styles.css"), "utf8");
const css = rawCss
  .replace(/\s*\/\* Default palette: ember \(#EA580C\) — toggle "Rust" for terracotta \*\/\n/, "\n")
  .replace(/html\[data-orange="rust"\]\s*{[\s\S]*?\n}\n\n/, "")
  .replace(/html\[data-orange="cobalt"\]\s*{[\s\S]*?\n}\n\n/, "")
  .replace(/\/\* ── Dev: orange palette toggle[\s\S]*$/, "");

let lastUpdatedDate = "";
let lastUpdatedUrl = "https://github.com/rohanthmarem/rohanth-site";
try {
  const hash = execSync("git log -1 --format=%H").toString().trim();
  const raw = execSync('git log -1 --format=%cd --date=format:"%b %d, %Y"').toString().trim();
  lastUpdatedDate = raw;
  lastUpdatedUrl = `https://github.com/rohanthmarem/rohanth-site/commit/${hash}`;
} catch {
  lastUpdatedDate = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
}

const arrowSvg = `<svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <style is:global set:html={css}></style>
  </head>
  <body>
    <div class="tbc-root">
      <div class="tbc-pad-h">
        <div class="tbc-wrap">
          <nav class="tbc-nav tbc-fu tbc-d1" aria-label="Primary">
            <a href="/" class="tbc-logo" aria-label="rohanth home">
              <span class="tbc-logo-mark">rohanth</span>
            </a>
            <div class="tbc-nav-links">
              <a href="/projects" class="tbc-nav-link">Projects</a>
              <a href="https://rohanth.substack.com/" class="tbc-nav-link">Writing</a>
              <a href="/thoughts" class="tbc-nav-link">Thoughts</a>
              <a href="/inspiration" class="tbc-nav-link">Inspiration</a>
              <a href="/sidequests" class="tbc-nav-link">Sidequests</a>
            </div>
          </nav>
          <slot />
        </div>
      </div>

      <footer class="tbc-footer">
        <div class="tbc-pad-h">
          <div class="tbc-wrap">
            <div class="tbc-footer-top">
              <a href={lastUpdatedUrl} target="_blank" rel="noopener" class="tbc-footer-link">
                Last updated {lastUpdatedDate}
                <svg width="8" height="8" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                  <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                </svg>
              </a>
              <div class="tbc-footer-links">
                <a href="https://github.com/rohanthmarem" target="_blank" rel="noopener" class="tbc-footer-link">
                  GitHub
                  <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </a>
                <a href="https://twitter.com/rohanthmarem" target="_blank" rel="noopener" class="tbc-footer-link">
                  Twitter / X
                  <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </a>
                <a href="mailto:hello@rohanth.com" class="tbc-footer-link">
                  Email
                  <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </a>
                <button type="button" id="tbc-color-shuffle" style="background:none;border:none;color:var(--footer-link);cursor:pointer;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:4px 0 0;display:block;opacity:0.5;letter-spacing:-0.03em;">✦</button>
              </div>
            </div>
          </div>
        </div>
        <div style="position: relative">
          <div class="tbc-wordmark-clip tbc-pad-h">
            <span class="tbc-wordmark" aria-hidden="true">rohanth</span>
          </div>
        </div>
      </footer>
    </div>
    <script>
      (function () {
        var n = document.querySelector<HTMLElement>('.tbc-nav');
        if (!n) return;
        var nav = n;
        var O = 5000;
        n.addEventListener('mousemove', function (e: MouseEvent) {
          var r = nav.getBoundingClientRect();
          nav.style.setProperty('--grid-vx', (e.clientX - r.left + O) + 'px');
          nav.style.setProperty('--grid-vy', (e.clientY - r.top) + 'px');
          nav.style.setProperty('--grid-op', '1');
        });
        n.addEventListener('mouseleave', function () {
          nav.style.setProperty('--grid-op', '0');
        });
      })();
    </script>
    <script>
      (function () {
        var CHARS = '!#%&*+<=>?@[]^_|~\\/{}';
        var states = new WeakMap<Element, { nodes: Text[]; originals: string[]; timer: number }>();

        function getState(el: Element) {
          var existing = states.get(el);
          if (existing) return existing;
          var nodes: Text[] = [];
          var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          var node = walker.nextNode();
          while (node) {
            if (node.nodeValue && node.nodeValue.trim()) nodes.push(node as Text);
            node = walker.nextNode();
          }
          var state = {
            nodes: nodes,
            originals: nodes.map(function (textNode) { return textNode.nodeValue || ''; }),
            timer: 0,
          };
          states.set(el, state);
          return state;
        }

        function scramble(el: Element) {
          var state = getState(el);
          clearInterval(state.timer);
          var maxLen = Math.max.apply(null, state.originals.map(function (text) { return text.length; }));
          var tick = 0;
          state.timer = window.setInterval(function () {
            var wave = tick * 1.1;
            if (wave > maxLen + 3) {
              clearInterval(state.timer);
              restore(el);
              return;
            }
            state.nodes.forEach(function (textNode, index) {
              var original = state.originals[index];
              var out = '';
              for (var i = 0; i < original.length; i++) {
                var ch = original[i];
                if (ch === ' ') { out += ' '; continue; }
                out += Math.abs(i - wave) < 2.2
                  ? CHARS[Math.floor(Math.random() * CHARS.length)]
                  : ch;
              }
              textNode.nodeValue = out;
            });
            tick++;
          }, 40);
        }

        function restore(el: Element) {
          var state = states.get(el);
          if (!state) return;
          clearInterval(state.timer);
          var active = state;
          active.nodes.forEach(function (textNode, index) {
            textNode.nodeValue = active.originals[index];
          });
        }

        var links = document.querySelectorAll('a.tbc-nav-link, a.tbc-about-tag, a.tbc-text-link, a.tbc-footer-link, .tbc-prose a');
        links.forEach(function (link) {
          link.addEventListener('mouseenter', function () { scramble(link); });
          link.addEventListener('mouseleave', function () { restore(link); });
        });
      })();
    </script>
  </body>
  <script>import "../colorShuffle.ts"</script>
  <Analytics />
</html>
