---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { execSync } from "node:child_process";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;

const sourceRoot = resolve(process.cwd(), "src/source");
const rawCss = readFileSync(resolve(sourceRoot, "styles.css"), "utf8");
const cobaltVars = rawCss.match(/html\[data-orange="cobalt"\]\s*{([\s\S]*?)\n}/)?.[1] ?? "";
const css = rawCss
  .replace(/\s*\/\* Default palette: ember \(#EA580C\) — toggle "Rust" for terracotta \*\/\n/, "\n")
  .replace(/html\[data-orange="rust"\]\s*{[\s\S]*?\n}\n\n/, "")
  .replace(/html\[data-orange="cobalt"\]\s*{[\s\S]*?\n}\n\n/, "")
  .replace(/\/\* ── Dev: orange palette toggle[\s\S]*$/, "")
  .replace(/:root\s*{([\s\S]*?)\n}/, (_match, vars) => `:root {${vars}\n${cobaltVars}\n}`);

let lastUpdatedDate = "";
let lastUpdatedUrl = "https://github.com/rohanthmarem/rohanth-site";
try {
  const hash = execSync("git log -1 --format=%H").toString().trim();
  const raw = execSync('git log -1 --format=%cd --date=format:"%b %d, %Y"').toString().trim();
  lastUpdatedDate = raw;
  lastUpdatedUrl = `https://github.com/rohanthmarem/rohanth-site/commit/${hash}`;
} catch {
  lastUpdatedDate = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
}

const arrowSvg = `<svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3"/></svg>`;
---

<!doctype html>
<html lang="en" data-orange="cobalt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7e8da" />
    <title>{title}</title>
    <style is:global set:html={css}></style>
  </head>
  <body>
    <div class="tbc-root">
      <div class="tbc-pad-h">
        <div class="tbc-wrap">
          <nav class="tbc-nav tbc-fu tbc-d1" aria-label="Primary">
            <a href="/" class="tbc-logo" aria-label="rohanth home">
              <span class="tbc-logo-mark">rohanth</span>
            </a>
            <div class="tbc-nav-links">
              <a href="/projects" class="tbc-nav-link">Projects</a>
              <a href="/writing" class="tbc-nav-link">Writing</a>
              <a href="/inspiration" class="tbc-nav-link">Inspiration</a>
              <a href="/sidequests" class="tbc-nav-link">Sidequests</a>
            </div>
          </nav>
          <slot />
        </div>
      </div>

      <footer class="tbc-footer">
        <div class="tbc-pad-h">
          <div class="tbc-wrap">
            <div class="tbc-footer-top">
              <a href={lastUpdatedUrl} target="_blank" rel="noopener" class="tbc-footer-link">
                Last updated {lastUpdatedDate}
                <svg width="8" height="8" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                  <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                </svg>
              </a>
              <div class="tbc-footer-links">
                <a href="https://github.com/rohanthmarem" target="_blank" rel="noopener" class="tbc-footer-link">
                  GitHub
                  <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </a>
                <a href="https://twitter.com/rohanthmarem" target="_blank" rel="noopener" class="tbc-footer-link">
                  Twitter / X
                  <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </a>
                <a href="mailto:hello@rohanth.com" class="tbc-footer-link">
                  Email
                  <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="flex-shrink:0">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </a>
                <button type="button" id="tbc-color-shuffle" style="background:none;border:none;color:var(--footer-link);cursor:pointer;font-family:'IBM Plex Mono',monospace;font-size:11px;padding:4px 0 0;display:block;opacity:0.5;letter-spacing:-0.03em;">✦</button>
              </div>
            </div>
          </div>
        </div>
        <div style="position: relative">
          <div class="tbc-wordmark-clip tbc-pad-h">
            <span class="tbc-wordmark" aria-hidden="true">rohanth</span>
          </div>
        </div>
      </footer>
    </div>
    <script>
      (function () {
        var n = document.querySelector('.tbc-nav');
        if (!n) return;
        var O = 5000;
        n.addEventListener('mousemove', function (e) {
          var r = n.getBoundingClientRect();
          n.style.setProperty('--grid-vx', (e.clientX - r.left + O) + 'px');
          n.style.setProperty('--grid-vy', (e.clientY - r.top) + 'px');
          n.style.setProperty('--grid-op', '1');
        });
        n.addEventListener('mouseleave', function () {
          n.style.setProperty('--grid-op', '0');
        });
      })();
    </script>
  </body>
  <script>import "../colorShuffle.ts"</script>
</html>
