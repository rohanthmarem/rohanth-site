---
// Markdown/MDX images become numbered figures; the caption is the title, else the alt text.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
}

const { src, alt = "", title } = Astro.props;
const caption = title || alt;
---
<figure class="fig">
  {typeof src === "string" ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" class="img-outline" data-dither />
  ) : (
    <Image src={src} alt={alt} widths={[480, 720, 1080, 1440]} sizes="(max-width: 720px) 100vw, 860px" class="img-outline" data-dither />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
