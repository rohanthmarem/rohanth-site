---
// Left sidebar navigation (after cognition.com): follows the page on wide screens and steps
// aside for full-width sections; a top bar with a menu on narrow ones. Pages can add to it through Base's "sidebar" slot (e.g. post contents).

interface Props {
  current?: string;
}
const { current } = Astro.props;
const items = [
  ["home", "/"],
  ["projects", "/projects"],
  ["writing", "/writing"],
  ["inspiration", "/inspiration"],
  ["sidequests", "/sidequests"],
] as const;
---
<aside class="side">
  <div class="side-inner">

    <nav class="side-nav" aria-label="Primary">
      <ul>
        {items.map(([key, href]) => (
          <li><a href={href} aria-current={current === key ? "page" : undefined} data-scramble-hover><span>{key}</span></a></li>
        ))}
      </ul>
    </nav>

    <details class="side-menu">
      <summary>menu</summary>
      <ul>
        {items.map(([key, href]) => (
          <li><a href={href} aria-current={current === key ? "page" : undefined}>{key}</a></li>
        ))}
      </ul>
    </details>

    <div class="side-extra"><slot /></div>
  </div>
</aside>

<style>
  .side { position: relative; z-index: 1; }
  /* Desktop: the menu sticks natively (smooth, compositor-driven). Near a full-width section the
     script pins it in place (position:absolute) so it scrolls away with that section, then hands
     it back to sticky with a fade once the section has passed. No per-frame JS positioning. */
  .side-inner { position: sticky; top: 40px; margin-top: 140px; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; padding: 0 24px 0 0; max-height: calc(100vh - 80px); overflow-y: auto; scrollbar-width: none; transition: opacity 260ms var(--ease-out), filter 260ms var(--ease-out); }
  .side-inner.is-parked { position: absolute; left: 0; right: 0; margin-top: 0; }
  .side-inner.is-back { animation: side-in 420ms var(--ease-out) both; }
  @keyframes side-in { from { opacity: 0; filter: blur(6px); transform: translateY(-6px); } }
  /* covered by content it can't sit above (e.g. the inspiration fan): fade into the page */
  .side-inner.is-covered { opacity: 0; filter: blur(8px); pointer-events: none; }
  .side-inner::-webkit-scrollbar { display: none; }
  .side-nav ul, .side-menu ul { list-style: none; margin: 0; padding: 0; }
  .side-nav a { position: relative; display: block; padding: 3px 0; font: 14px/1.45 var(--mono); color: var(--ink); transition: color var(--dur-fast) var(--ease-out); }
  .side-nav a:hover { color: var(--accent); }
  .side-nav a[aria-current="page"] { color: var(--accent); }
  .side-nav a[aria-current="page"]::before { content: ""; position: absolute; left: -11px; top: 50%; width: 2px; height: 14px; transform: translateY(-50%); background: var(--accent); }
  .side-menu { display: none; }
  .side-extra:empty { display: none; }
  .side-extra { width: 100%; margin-top: 18px; }

  @media (max-width: 1023px) {
    .side-inner, .side-inner.is-parked { position: static; margin-top: 0; flex-direction: row; align-items: center; justify-content: flex-end; gap: 16px; padding: 18px 0; max-height: none; overflow: visible; }
    .side-nav, .side-extra { display: none; }
    .side-menu { display: block; position: relative; }
    .side-menu summary { list-style: none; min-height: 40px; display: grid; place-items: center; padding: 0 10px; font: 13px/1 var(--mono); box-shadow: inset 0 0 0 1px var(--ink); }
    .side-menu summary::-webkit-details-marker { display: none; }
    .side-menu[open] summary { background: var(--ink); color: var(--paper); }
    .side-menu ul { position: absolute; right: 0; top: calc(100% + 8px); z-index: 20; min-width: 180px; padding: 8px 0; background: var(--surface); box-shadow: var(--shadow-border-hover); }
    .side-menu a { display: block; padding: 10px 16px; font: 14px/1.2 var(--mono); }
    .side-menu a[aria-current="page"] { color: var(--accent); }
  }
</style>

<script>
  // Two states, switched only at the handoff points (never per-frame positioning):
  //   follow — native position:sticky, glides with the page
  //   parked — position:absolute at the spot it reached, so it scrolls away with a full-width
  //            section exactly like the content does
  // When the section has gone by, it returns to sticky with a short fade-in. If a section starts
  // too high to park above, the menu fades out while covered instead.
  const side = document.querySelector<HTMLElement>(".side");
  const inner = side?.querySelector<HTMLElement>(".side-inner");
  const wide = matchMedia("(min-width: 1024px)");
  const NATURAL = 140; // resting offset inside the sidebar
  const STICK = 40; // sticky offset from the top of the viewport
  const GAP = 40; // clearance kept above a full-width section
  const MIN = 24; // highest it may park when a section starts near the top

  if (side && inner) {
    const spans = () => document.querySelectorAll<HTMLElement>(".content > .span, .content > .span-bleed, [data-span]");
    let state: "follow" | "parked" | "covered" = "follow";
    let hideTimer = 0;
    let pending = false; // fading out before pinning above a section
    let parkedTop = 0;

    // vertical extent of a full-width section, in sidebar coordinates, where it reaches the menu column
    const extent = (el: HTMLElement, sideTop: number, menuRight: number) => {
      const rects = [el.getBoundingClientRect()];
      if (el.dataset.span === "deep") for (const c of el.children) rects.push(c.getBoundingClientRect());
      let top = Infinity, bottom = -Infinity;
      for (const r of rects) {
        if (r.width === 0 || r.left > menuRight) continue;
        top = Math.min(top, r.top); bottom = Math.max(bottom, r.bottom);
      }
      return top === Infinity ? null : { top: top + scrollY - sideTop, bottom: bottom + scrollY - sideTop };
    };

    const toFollow = (fade: boolean) => {
      clearTimeout(hideTimer);
      pending = false;
      inner.classList.remove("is-parked", "is-covered");
      inner.style.top = "";
      if (fade) { inner.classList.remove("is-back"); void inner.offsetWidth; inner.classList.add("is-back"); }
      state = "follow";
    };
    const toParked = (y: number) => {
      clearTimeout(hideTimer);
      pending = false;
      parkedTop = y;
      inner.classList.remove("is-back", "is-covered");
      inner.style.top = `${Math.round(y)}px`;
      inner.classList.add("is-parked");
      state = "parked";
    };

    const update = () => {
      if (!wide.matches) { if (state !== "follow") toFollow(false); return; }
      const sideTop = side.getBoundingClientRect().top + scrollY;
      const h = inner.offsetHeight;
      const follow = scrollY + STICK - sideTop; // where sticky would put the menu
      const y = Math.max(NATURAL, follow);
      const menuRight = side.getBoundingClientRect().left + inner.offsetWidth;

      let conflict: { top: number; bottom: number } | null = null;
      for (const el of spans()) {
        const e = extent(el, sideTop, menuRight);
        if (e && y + h + GAP > e.top && follow < e.bottom + GAP) { conflict = e; break; }
      }

      if (!conflict) {
        // scrolling back up past the pin point is seamless; coming out below a section fades in
        if (state === "parked") toFollow(follow > parkedTop + 1);
        else if (state === "covered") toFollow(true);
        return;
      }
      const parkAt = conflict.top - h - GAP;
      if (parkAt < MIN) { // no room above the section
        if (state !== "covered") { inner.classList.add("is-covered"); state = "covered"; }
        return;
      }
      if (state === "parked" || pending) return; // already scrolling away / fading out
      if (state === "follow" && y > parkAt + 4 && follow > NATURAL) {
        // re-entering a section from below (scrolling up): fade out, then pin above it
        inner.classList.add("is-covered");
        pending = true;
        hideTimer = window.setTimeout(() => toParked(parkAt), 220);
        state = "covered";
        return;
      }
      toParked(Math.min(y, parkAt)); // pin exactly where it is (or above the section)
    };

    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    new ResizeObserver(update).observe(document.body);
    update();
  }
</script>
