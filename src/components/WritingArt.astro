// Hand-authored line-art covers for writing posts, keyed by post id, with a generic
// article wireframe for posts that don't have one yet. Static SVG, zero JS; strokes use
// currentColor; pass `fg`/`bg`, or leave them off to inherit CSS color/background.
interface Props {
  id: string;
  fg?: string;
  bg?: string;
  class?: string;
}
const { id, fg, bg, class: cls } = Astro.props;
const style = [fg && `color:${fg}`, bg && `background:${bg}`].filter(Boolean).join(";") || undefined;

