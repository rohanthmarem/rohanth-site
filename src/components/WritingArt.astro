<div class:list={["cover", cls]} style={style}>
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMin slice" width="100%" height="100%" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={art[id] ?? art.fallback} />
