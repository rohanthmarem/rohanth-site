---
// On the inner pages the notebook is pushed off to the right edge, with only its spine showing. It slides
// out a little on hover and opens in place (NotebookOpen.astro grows the book out of it). Coming from the
// home page, a view transition carries the cover over to here (see global.css).
import { getImage } from "astro:assets";
import { covers } from "../data/notebook";
import front from "../assets/notebook/front.jpg";

// the same files and sizes as the home page cover, so going between the two the image is already loaded
const image = await getImage({ src: front, widths: [640, 960, 1268], format: "webp" as const, quality: 82 });
---
<a class="spine" href="/#notebook" data-nbo-open="notebook" data-notebook data-spine aria-label="open my notebook">
  <span class="book" data-book>
    {/* phones hide the spine; an empty source there means its cover isn't downloaded for nothing */}
    <picture>
      <source media="(max-width: 899px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
      <img src={image.src} srcset={image.srcSet.attribute} sizes="620px" width="1268" height="1834" alt="" draggable="false" style={`clip-path:${covers.front.book}`} />
    </picture>
  </span>
  <span class="label">open notebook</span>
</a>

<style>
  .spine {
    --peek: 30px;
    position: fixed; z-index: 30; top: 50%; right: 0; height: min(76vh, 760px); aspect-ratio: 1268 / 1834;
    translate: calc(100% - var(--peek)) -50%;
    transition: translate 420ms var(--ease-out-strong);
  }
  .spine:hover, .spine:focus-visible { --peek: 54px; }
  .spine:active { --peek: 46px; }
  .spine:focus-visible { outline: none; }
  .book { position: absolute; inset: 0; view-transition-name: notebook; filter: drop-shadow(-2px 0 3px rgb(30 25 25 / 0.22)) drop-shadow(-12px 0 24px rgb(30 25 25 / 0.16)); }
  .book picture { display: contents; }
  .book img { width: 100%; height: 100%; user-select: none; -webkit-user-select: none; }
  .label {
    position: absolute; right: calc(100% + 12px); top: 50%; translate: 6px -50%; white-space: nowrap;
    padding: 6px 8px; font: 12px/1 var(--mono); color: var(--ink); background: var(--paper); box-shadow: var(--shadow-border);
    opacity: 0; pointer-events: none; transition: opacity var(--dur) var(--ease-out), translate var(--dur) var(--ease-out);
  }
  .spine:is(:hover, :focus-visible) .label { opacity: 1; translate: 0 -50%; }
  .spine:focus-visible .label { box-shadow: 0 0 0 2px var(--accent); }
  /* phones: the menu's notebook link opens it instead */
  @media (max-width: 899px) { .spine { display: none; } }
  @media print { .spine { display: none; } }
</style>
