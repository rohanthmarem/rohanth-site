  .nbo .paper .card { position: absolute; left: 14cqw; bottom: 22cqw; width: 52cqw; height: 44cqw; padding: 4.4cqw 5cqw; rotate: -5deg; background: #fffdf7; color: var(--pen); text-decoration: none; box-shadow: 0 0.6cqw 1.4cqw rgb(0 0 0 / 0.15); transition: translate 300ms var(--ease-out-strong), color var(--dur-fast) var(--ease-out); }
