<script>
  import { fillCaption } from "../scripts/sticker-caption";

  const dialog = document.querySelector<HTMLDialogElement>("[data-nbo]");
  // set up once any page transition has finished (Base.astro), so it doesn't stall the notebook's slide
  if (dialog) ((window as { __settled?: Promise<void> }).__settled ?? Promise.resolve()).then(() => {
    const book = dialog.querySelector<HTMLElement>("[data-nbo-book]")!;
    const stage = dialog.querySelector<HTMLElement>("[data-nbo-stage]")!;
    const chrome = [...dialog.querySelectorAll<HTMLElement>("[data-nbo-chrome]")];
    const where = dialog.querySelector<HTMLElement>("[data-nbo-where]")!;
    const prevButton = dialog.querySelector<HTMLButtonElement>("[data-nbo-prev]")!;
    const nextButton = dialog.querySelector<HTMLButtonElement>("[data-nbo-next]")!;
    const leaves = [...book.querySelectorAll<HTMLElement>(".leaf")];
    const sides = [...book.querySelectorAll<HTMLElement>(".side")]; // page order
    const N = leaves.length;
    const narrow = matchMedia("(max-width: 760px)");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const homeBook = document.querySelector<HTMLElement>("[data-notebook] [data-book]");
    const homeScene = homeBook?.parentElement;
    const backCover = dialog.querySelector<HTMLElement>("[data-nbo-back]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-nbo-caption]")!;

    // section name -> first page; "notebook" is the contents page, and "inspiration" opens on its first section
    const starts: [string, number][] = [["notebook", 2], ["inspiration", 3], ...sides.filter((s) => s.dataset.section).map((s) => [s.dataset.section!, Number(s.dataset.page)] as [string, number])];
    const sectionOf = (page: number) => starts.reduce((found, [key, start]) => (page >= start ? key : found), "notebook");
    const leafFor = (page: number) => (page % 2 ? (page + 1) / 2 : page / 2);

    let turned = 0; // leaves turned over to the left
    let current = 0; // the page in view (the right-hand one on a spread)
    let view: "L" | "R" = "R"; // phones: which side of the spread is in view
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    // A page lifts slowly, falls quicker and settles; the book slides to centre on the same curve.
    const TURN_EASE = "cubic-bezier(0.5, 0.05, 0.25, 1)";
    const MOVE_EASE = "cubic-bezier(0.22, 1, 0.36, 1)";

    // A leaf on the left stacks by index (later leaves on top), on the right the other way round.
    // A turning leaf changes sides when it stands upright (90°), and that is exactly when its stacking
    // order has to flip: it's a step in the same keyframes as the rotation, so the two can't drift.
    const z = (k: number, left: boolean) => (left ? k : N - k);
    const isLeft = leaves.map(() => false);
    const running = new Map<HTMLElement, Animation>();

    // Each side is hidden outright while it faces away. backface-visibility alone isn't enough: Safari lets
    // anything on a page with its own layer (the tilted photos) show through, mirrored, from the far side.
    const faces = (k: number) => [sides[2 * k], sides[2 * k + 1]] as const;
    const faceKeys = (showing: boolean, after: boolean) => [
      { offset: 0, opacity: showing ? 1 : 0 }, { offset: 0.5, opacity: showing ? 1 : 0 },
      { offset: 0.5, opacity: after ? 1 : 0 }, { offset: 1, opacity: after ? 1 : 0 },
    ];
    const faceAnims = new Map<HTMLElement, Animation[]>();
    function rest(k: number) {
      leaves[k].style.transform = isLeft[k] ? "rotateY(-180deg)" : "";
      leaves[k].style.zIndex = String(z(k, isLeft[k]));
      const [front, back] = faces(k);
      front.style.opacity = isLeft[k] ? "0" : "";
      back.style.opacity = isLeft[k] ? "" : "0";
    }
    function turnLeaf(k: number, left: boolean, delay: number, duration: number) {
      const leaf = leaves[k];
      isLeft[k] = left;
      rest(k); // where it ends up; the animation plays on top of this
      const busyLeaf = running.get(leaf);
      if (busyLeaf) {
        // turned back (or forward again) mid-turn: run the same turn backwards from where it is
        busyLeaf.reverse();
        faceAnims.get(leaf)?.forEach((a) => a.reverse());
        return;
      }
      const [from, to] = left ? [0, -180] : [-180, 0];
      const anim = leaf.animate([
        { offset: 0, transform: `rotateY(${from}deg)`, zIndex: z(k, !left) },
        { offset: 0.5, transform: "rotateY(-90deg)", zIndex: z(k, !left) },
        { offset: 0.5, transform: "rotateY(-90deg)", zIndex: z(k, left) },
        { offset: 1, transform: `rotateY(${to}deg)`, zIndex: z(k, left) },
      ], { duration, delay, easing: TURN_EASE, fill: "backwards" });
      // the same timing and curve, so each side appears and disappears exactly as the leaf passes 90°
      const [front, back] = faces(k);
      const timing = { duration, delay, easing: TURN_EASE, fill: "backwards" as const };
      // turning over, the front shows until 90° and the back after it; turning back, the reverse
      const sideAnims = [front.animate(faceKeys(left, !left), timing), back.animate(faceKeys(!left, left), timing)];
      faceAnims.set(leaf, sideAnims);
      running.set(leaf, anim);
      const done = () => { if (running.get(leaf) === anim) { running.delete(leaf); cull(); } };
      // drop it once it's done: a reversed run would otherwise keep holding its start through `fill`
      anim.onfinish = () => { done(); anim.cancel(); };
      anim.oncancel = () => { done(); sideAnims.forEach((a) => a.cancel()); };
      sideAnims.forEach((a) => (a.onfinish = () => a.cancel()));
    }

    /** Turn to `target` leaves over; returns how long until the turning is done. */
    // Only draw the leaves that can be seen: both covers (they frame the book), the open spread, and
    // anything turning along with the leaves either side of it. The rest lie flat under the top
    // pages; drawing all 24 pages made the first frame enormous and overflowed GPU memory on retina
    // screens, which is what showed up as pages blanking or clipping mid-turn.
    function cull() {
      const keep = new Set([0, N - 1, turned - 1, turned]);
      // closed, only the cover shows: the pages under it are plain rectangles and would peek out past
      // the photo's rounded, clipped edge
      if (turned === 0 && !running.size) keep.clear(), keep.add(0);
      if (turned === N && !running.size) keep.clear(), keep.add(N - 1);
      leaves.forEach((leaf, k) => { if (running.has(leaf)) [k - 1, k, k + 1].forEach((i) => keep.add(i)); });
      leaves.forEach((leaf, k) => (leaf.style.visibility = keep.has(k) ? "" : "hidden"));
    }

    /** `after` holds the turning back that long, on the animation clock (not a timer), so it can be
     * lined up exactly with the stage moving when the book opens or closes. */
    // phones: slide the book so one side of the spread is centred
    function pan(to: "L" | "R", { animate = true, duration = 520, delay = 0, ease = MOVE_EASE } = {}) {
      view = to;
      book.style.transition = animate && !reduce.matches ? `transform ${duration}ms ${ease} ${delay}ms` : "none";
      book.style.transform = to === "R" ? "translateX(-25%)" : "translateX(25%)";
    }

    function turnTo(target: number, { animate = true, quick = false, after = 0, side }: { animate?: boolean; quick?: boolean; after?: number; side?: "L" | "R" } = {}) {
      target = Math.max(0, Math.min(N, target));
      const moving = leaves.map((_, k) => k).filter((k) => (k < target) !== isLeft[k]);
      if (target < turned) moving.reverse();
      const duration = quick ? 620 : moving.length > 1 ? 720 : 860;
      const stagger = moving.length > 1 ? Math.min(quick ? 40 : 75, (quick ? 220 : 420) / (moving.length - 1)) : 0;
      if (!animate) {
        running.forEach((a) => a.cancel());
        leaves.forEach((_, k) => { isLeft[k] = k < target; rest(k); });
      } else {
        moving.forEach((k, i) => turnLeaf(k, k < target, after + i * stagger, duration));
      }
      // the closed book sits centred on its cover; it slides over as the cover (or back cover) turns
      const shiftLeaf = target === 0 || turned === 0 ? 0 : target === N || turned === N ? N - 1 : -1;
      const shiftAt = moving.indexOf(shiftLeaf);
      const from = turned;
      turned = target;
      if (narrow.matches) {
        // the view follows the page over: forward lands on its back (left), back lands on the right
        const to = target === 0 ? "R" : target === N ? "L" : side ?? (target > from ? "L" : "R");
        pan(to, { animate, duration: moving.length ? duration : 520, delay: after, ease: moving.length ? TURN_EASE : MOVE_EASE });
      } else {
        book.style.transform = "";
        book.style.transition = animate ? `transform ${duration}ms ${TURN_EASE} ${after + Math.max(0, shiftAt) * stagger}ms` : "none";
      }
      book.classList.toggle("closed-front", turned === 0);
      book.classList.toggle("closed-back", turned === N);
      stage.classList.toggle("closed", turned === 0 || turned === N);
      current = narrow.matches ? (view === "R" ? 2 * turned : 2 * turned - 1) : turned === N ? 2 * N - 1 : 2 * turned;
      cull();
      sync();
      return animate && moving.length ? after + (moving.length - 1) * stagger + duration : 0;
    }

    // Stickers on the back cover can be picked up, like the front cover's on the home page. The pick
    // only lives while the back cover is in view.
    let picked: HTMLButtonElement | null = null;
    function pick(s: HTMLButtonElement | null) {
      picked?.setAttribute("aria-pressed", "false");
      picked = s;
      backCover.classList.toggle("has-pick", !!s);
      caption.classList.toggle("on", !!s);
      if (!s) return;
      s.setAttribute("aria-pressed", "true");
      fillCaption(caption, s.dataset);
    }
    backCover.querySelectorAll<HTMLButtonElement>(".sticker").forEach((s) =>
      s.addEventListener("click", () => pick(s === picked ? null : s)),
    );

    function sync() {
      const spread = !narrow.matches;
      if (picked && (spread ? turned !== N : current !== 2 * N - 1)) pick(null);
      sides.forEach((side, i) => (side.inert = spread ? i !== 2 * turned - 1 && i !== 2 * turned : i !== current));
      const first = spread ? (turned === 0 ? 0 : turned === N ? 2 * N - 1 : 2 * turned - 1) : current;
      const last = spread ? (turned === 0 || turned === N ? first : 2 * turned) : current;
      where.textContent = first === 0 ? "cover" : first === 2 * N - 1 ? "back cover" : first === last ? `page ${first}` : `pages ${first}–${last}`;
      prevButton.disabled = spread ? turned === 0 : current === 0;
      nextButton.disabled = spread ? turned === N : current === 2 * N - 1;
      // on a spread, a section that starts on the right-hand page wins over the one carrying on from the left
      const startsAt = (page: number) => starts.some(([, start]) => start === page);
      const section = sectionOf(spread ? (startsAt(first) || !startsAt(last) ? Math.max(first, 0) : last) : current);
      dialog!.querySelectorAll<HTMLElement>(".tab").forEach((tab) => tab.setAttribute("aria-current", String(tab.dataset.nboGoto === section)));
      if (dialog!.open && !busy && location.hash !== `#${section}`) history.replaceState(history.state, "", `#${section}`);
    }

    function goto(key: string, animate = true, after = 0) {
      const page = starts.find(([k]) => k === key)?.[1] ?? 2;
      return turnTo(leafFor(page), { animate: animate && !reduce.matches, after, side: page % 2 ? "L" : "R" });
    }
    const step = (by: 1 | -1) => {
      if (!narrow.matches) { turnTo(turned + by, { animate: !reduce.matches }); return; }
      // phones read one side at a time: from a left page, forward just moves across to the right one;
      // from a right page it turns the leaf, and the view follows it over (and the reverse going back)
      if (by > 0 ? current >= 2 * N - 1 : current <= 0) return;
      if ((by > 0) === (view === "L")) {
        pan(view === "L" ? "R" : "L");
        current += by;
        cull();
        sync();
      } else turnTo(turned + by, { animate: !reduce.matches });
    };

    /** The FLIP from the cover on the home page (or the spine at the edge of the inner pages) to the
     * closed book in the dialog (or back again).
     * Worked out from the stage's resting box, not measured, so it's right even mid-turn: closed, the
     * cover is the right half of the spread slid back to the middle, i.e. centred on the stage. */
    function fromHome() {
      if (!homeBook) return null;
      const home = homeBook.getBoundingClientRect();
      if (!home.width || home.bottom < 0 || home.top > innerHeight) return null;
      const box = stage.getBoundingClientRect();
      const dx = home.left + home.width / 2 - (box.left + box.width / 2);
      const dy = home.top + home.height / 2 - (box.top + box.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${home.width / (box.width / 2)})`;
    }
    const fade = (on: boolean, duration: number, delay = 0) =>
      chrome.map((el) => el.animate([{ opacity: on ? 0 : 1 }, { opacity: on ? 1 : 0 }], { duration, delay, easing: "ease-out", fill: "both" }));

    // The dialog's first frame is a heavy one (every page laid out, the photos rastered), and WebKit starts
    // an animation's clock when it's created rather than when it's first painted: by the time that frame
    // is up the opening is several hundred ms in, so the move and the first turn are mostly skipped. Every
    // animation in the dialog is held on its first frame until that frame has been painted, then let go.
    const nextFrame = () => new Promise((resolve) => requestAnimationFrame(() => resolve(undefined)));
    async function holdFirstFrame() {
      const held = dialog!.getAnimations({ subtree: true });
      held.forEach((a) => a.pause());
      await nextFrame();
      await nextFrame();
      held.forEach((a) => { if (a.playState === "paused") a.play(); });
    }

    let busy = false; // opening or closing: the pages turn, but the URL shouldn't follow them
    async function open(key: string, { instant = false } = {}) {
      if (dialog!.open) return goto(key);
      busy = true;
      stage.classList.add("moving");
      warm();
      document.documentElement.classList.add("nbo-open");
      dialog!.showModal();
      const animate = !instant && !reduce.matches;
      if (narrow.matches && animate) {
        // the closed book rises into view, then opens to the section, a page at a time
        turnTo(0, { animate: false });
        fade(true, 300);
        // the book, not the stage: a transform on the stage would drag the fixed tabs along with it
        const rise = book.animate([{ opacity: 0, translate: "0 18px", scale: "0.97" }, { opacity: 1, translate: "0 0", scale: "1" }], { duration: 460, easing: MOVE_EASE });
        const turning = goto(key, true, 260);
        await holdFirstFrame();
        await Promise.all([rise.finished, wait(turning)]);
      } else if (!animate) {
        goto(key, false);
      } else {
        // one continuous move: the cover travels from the home page and starts opening on the way
        turnTo(0, { animate: false });
        const from = fromHome();
        fade(true, 420);
        if (from) homeScene!.style.visibility = "hidden";
        const move = stage.animate(from ? [{ transform: from }, { transform: "none" }] : [{ opacity: 0, transform: "scale(0.96)" }, { opacity: 1, transform: "none" }], { duration: from ? 700 : 440, easing: MOVE_EASE });
        const turning = goto(key, true, from ? 240 : 100);
        await holdFirstFrame();
        await Promise.all([move.finished, wait(turning)]);
      }
      stage.classList.remove("moving");
      busy = false;
      sync();
    }

    async function close() {
      if (!dialog!.open || busy) return;
      busy = true;
      stage.classList.add("moving");
      pick(null);
      if (!reduce.matches) {
        let fading: Animation[];
        if (narrow.matches) {
          // shut the book, then let it drop away
          const delay = Math.max(0, turnTo(0, { quick: true }) - 200);
          fading = fade(false, 260, delay);
          await book.animate([{ opacity: 1 }, { opacity: 0, translate: "0 12px", scale: "0.98" }], { duration: 260, delay, easing: "ease-in", fill: "forwards" }).finished;
        } else {
          // the book closes and, while the cover is still coming down, heads back to the home page
          const to = fromHome();
          const turning = turnTo(0, { quick: true });
          const delay = Math.max(0, turning - 320);
          fading = fade(false, to ? 560 : 260, delay);
          await stage.animate(to ? [{ transform: "none" }, { transform: to }] : [{ opacity: 1 }, { opacity: 0, transform: "scale(0.97)" }], { duration: to ? 660 : 260, delay, easing: to ? MOVE_EASE : "ease-in", fill: "forwards" }).finished;
        }
        if (homeScene) homeScene.style.visibility = "";
        dialog!.close();
        stage.getAnimations().forEach((a) => a.cancel());
        book.getAnimations().forEach((a) => a.cancel());
        fading.forEach((a) => a.cancel());
      } else dialog!.close();
      if (homeScene) homeScene.style.visibility = "";
      document.documentElement.classList.remove("nbo-open");
      stage.classList.remove("moving");
      busy = false;
    }

    // Load and decode every photo in the pages before they're needed, so nothing decodes mid-turn.
    let warmed = false;
    function warm() {
      if (warmed) return;
      warmed = true;
      // the handwriting too: nothing on the page uses it until the notebook opens, so it isn't fetched before
      document.fonts?.load('1em "Rohanth Hand"').catch(() => {});
      dialog!.querySelectorAll("img").forEach((img) => { img.loading = "eager"; img.decode().catch(() => {}); });
    }
    const idle = (fn: () => void) => ("requestIdleCallback" in window ? requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 2000));
    // only the home page preloads; elsewhere the notebook is a sidetrack, so it waits for a hover
    if (!document.querySelector("[data-spine]")) addEventListener("load", () => setTimeout(() => idle(warm), 1200), { once: true });
    document.querySelectorAll("[data-nbo-open], [data-open-cover]").forEach((el) => el.addEventListener("pointerenter", warm, { once: true }));

    // the URL follows the notebook (#readings …), so the back button closes it and links can open it
    const valid = (key: string) => starts.some(([k]) => k === key);
    const requestClose = () => {
      if (history.state?.nbo) history.back();
      else { history.replaceState(null, "", location.pathname + location.search); close(); }
    };
    const openFromLink = (key: string) => {
      history.pushState({ nbo: true }, "", `#${key}`);
      open(key);
    };
    document.addEventListener("nbo:open", (e) => openFromLink((e as CustomEvent<string>).detail));
    addEventListener("popstate", () => {
      const key = location.hash.slice(1);
      if (valid(key)) open(key);
      else close();
    });

    document.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const target = e.target as Element;
      const opener = target.closest<HTMLElement>("[data-nbo-open]");
      if (opener) { e.preventDefault(); openFromLink(opener.dataset.nboOpen || "notebook"); return; }
      const jump = target.closest<HTMLElement>("[data-nbo-goto]");
      if (jump && dialog.contains(jump)) { e.preventDefault(); goto(jump.dataset.nboGoto!); }
    });
    dialog.querySelector("[data-nbo-close]")!.addEventListener("click", requestClose);
    // Escape puts a picked sticker back first, and only closes the notebook after that
    dialog.addEventListener("cancel", (e) => { e.preventDefault(); if (picked) pick(null); else requestClose(); });
    prevButton.addEventListener("click", () => step(-1));
    nextButton.addEventListener("click", () => step(1));
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && picked) { e.preventDefault(); e.stopPropagation(); const s = picked; pick(null); s.focus(); return; }
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
    });
    // a click anywhere but a sticker or its caption puts the sticker back (on the bare cover it also turns back);
    // otherwise a click on the empty space around the notebook closes it
    const around = [dialog, dialog.querySelector(".backdrop"), stage, book, stage.querySelector(".tabs"), dialog.querySelector(".pager")];
    dialog.addEventListener("click", (e) => {
      if (picked) { if (!(e.target as Element).closest(".sticker, [data-nbo-caption]")) pick(null); return; }
      if (around.includes(e.target as Element)) requestClose();
    });
    // clicking a page (anywhere that isn't a link) turns it: the right page forward, the left one back.
    // On a phone, with one page in view, a tap on its right half goes forward and its left half back.
    let swiped = false;
    book.addEventListener("click", (e) => {
      if (swiped) { swiped = false; return; }
      if ((e.target as Element).closest("a, button")) return;
      if (narrow.matches) { step(e.clientX > innerWidth / 2 ? 1 : -1); return; }
      const side = (e.target as Element).closest<HTMLElement>(".side");
      const i = side ? sides.indexOf(side) : -1;
      if (i === 2 * turned) step(1);
      else if (i === 2 * turned - 1) step(-1);
    });
    // a swipe turns it on touch screens
    let swipeX: number | null = null;
    book.addEventListener("pointerdown", (e) => { if (e.pointerType !== "mouse") swipeX = e.clientX; });
    book.addEventListener("pointerup", (e) => {
      if (swipeX === null) return;
      const dx = e.clientX - swipeX;
      swipeX = null;
      if (Math.abs(dx) > 40) { swiped = true; setTimeout(() => (swiped = false), 400); step(dx < 0 ? 1 : -1); }
    });
    narrow.addEventListener("change", () => {
      const page = current;
      turnTo(page ? leafFor(page) : 0, { animate: false, side: page % 2 ? "L" : "R" });
    });

    turnTo(0, { animate: false });
    const initial = location.hash.slice(1);
    if (valid(initial)) open(initial, { instant: true });
  });
</script>
