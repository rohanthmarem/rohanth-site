---
// The notebook, opened flat: the people, readings, shows and clippings that inspire me, kept the way a
// commonplace book is, in handwriting. Sidequests too. (Projects and writing have their own pages.) Wide
// screens get a two-page spread whose leaves turn in 3D; phones get one page at a time: the same turning
// book, zoomed in on one side of the spread, panning across as the pages turn.
//
// Leaf k carries page 2k on its front (a right-hand page) and page 2k + 1 on its back (a left-hand
// page). Leaf 0 is the front cover, the last leaf the back cover.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Page from "./notebook/Page.astro";
import Snap from "./notebook/Snap.astro";
import Check from "./notebook/Check.astro";
import { covers } from "../data/notebook";
import { inspiration, clippings, quests, links } from "../data/site";
import front from "../assets/notebook/front.jpg";
import back from "../assets/notebook/back.jpg";
import signature from "../assets/notebook/signature.svg?raw"; // traced from rohanth's own signature
import runStart from "../assets/sidequests/run-start.webp";
import bikeTrail from "../assets/sidequests/bike-trail.webp";
import ironmanSignup from "../assets/sidequests/ironman-signup.webp";
import foodKatsu from "../assets/sidequests/food-katsu.webp";
import foodIndian from "../assets/sidequests/food-indian.webp";
import foodUdon from "../assets/sidequests/food-udon.webp";
import photoDumbo from "../assets/sidequests/photo-dumbo.webp";
import photoWindow from "../assets/sidequests/photo-window.webp";
import photoConcert from "../assets/sidequests/photo-concert.webp";
import photoSf from "../assets/sidequests/photo-sf.webp";
import wingsFilm from "../assets/sidequests/wings-film.webp";
import karateReady from "../assets/sidequests/karate-ready.webp";
import karateJump from "../assets/sidequests/karate-jump.webp";

/** A photo for the pages. `share` is roughly how much of a page's width it takes, which sets `sizes`. */
const pic = async (src: ImageMetadata, share: number) => {
  const image = await getImage({ src, widths: [240, 400, 640, 960].filter((w) => w < src.width), format: "webp" as const, quality: 78 });
  // a page is at most ~600px wide on a spread and ~92vw on a phone
  return { src: image.src, srcset: image.srcSet.attribute, sizes: `(max-width: 760px) ${Math.round(92 * share)}vw, ${Math.round(600 * share)}px`, width: src.width, height: src.height };
};

const coverImage = (src: ImageMetadata) => getImage({ src, widths: [640, 960, 1268], format: "webp" as const, quality: 82 });
const [frontImage, backImage] = await Promise.all([coverImage(front), coverImage(back)]);

// The cover photos sit ~1% in from the hinge, and their spine edge catches a sliver of the table the
// notebook was photographed on, so the pages behind could peek out mid-turn. The photo is trimmed back to
// the cover's real edge, and a board in the cover's own colour (sampled from each photo) runs from there
// out to the hinge, keeping the photo's rounded corners.
const reshape = (poly: string, spineAtRight: boolean, fn: (x: number) => number) =>
  poly.replace(/([\d.]+)% ([\d.]+)%/g, (_, x, y) => {
    const n = Number(x);
    return `${(spineAtRight ? n > 94 : n < 6) ? fn(n).toFixed(2) : n}% ${y}%`;
  });
const spineXs = (poly: string, spineAtRight: boolean) =>
  [...poly.matchAll(/([\d.]+)% [\d.]+%/g)].map((m) => Number(m[1])).filter((x) => (spineAtRight ? x > 94 : x < 6));
// where the cover's real spine edge is in each photo (front: from the left; back: from the right)
const EDGE = { front: 1.6, back: 98.7 };
const frontLeft = Math.min(...spineXs(covers.front.book, false));
const backRight = Math.max(...spineXs(covers.back.book, true));
const coverClip = {
  front: reshape(covers.front.book, false, (x) => Math.max(x, EDGE.front)),
  back: reshape(covers.back.book, true, (x) => Math.min(x, EDGE.back)),
};
const boardClip = {
  front: reshape(covers.front.book, false, (x) => x - frontLeft),
  back: reshape(covers.back.book, true, (x) => x + (100 - backRight)),
};

const [people, readings, media] = [inspiration.people, inspiration.readings, inspiration.media];
const { scripts, notes } = clippings;

/** Where each section starts: the tabs, the contents page and the #hash all come from here. */
const sections = [
  { key: "people", page: 3, colour: "#f4cf5d" },
  { key: "readings", page: 4, colour: "#8fd0b2" },
  { key: "watching", page: 6, colour: "#f3a493" },
  { key: "clippings", page: 7, colour: "#c9b6ea" },
  { key: "sidequests", page: 11, colour: "#9dbcf0" },
];
const quest = Object.fromEntries(quests.map((q) => [q.slug, q]));
const [runStartPhoto, bikePhoto, signupPhoto] = await Promise.all([pic(runStart, 0.37), pic(bikeTrail, 0.24), pic(ironmanSignup, 0.54)]);
const [katsuPhoto, indianPhoto, udonPhoto] = await Promise.all([pic(foodKatsu, 0.34), pic(foodIndian, 0.44), pic(foodUdon, 0.44)]);
const [dumboPhoto, windowPhoto, concertPhoto, sfPhoto] = await Promise.all([pic(photoDumbo, 0.34), pic(photoWindow, 0.46), pic(photoConcert, 0.32), pic(photoSf, 0.34)]);
const [wingsPhoto, karateReadyPhoto, karateJumpPhoto] = await Promise.all([pic(wingsFilm, 0.48), pic(karateReady, 0.3), pic(karateJump, 0.3)]);
const ext = { target: "_blank", rel: "noopener" };
---

<dialog class="nbo" data-nbo aria-label="my notebook">
  <div class="backdrop" data-nbo-chrome></div>
  <button type="button" class="close" data-nbo-close data-nbo-chrome aria-label="close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg></button>

  <div class="stage" data-nbo-stage tabindex="-1" autofocus>
    <nav class="tabs" aria-label="Notebook sections">
      {sections.map((s) => (
        <a class="tab" href={`#${s.key}`} data-nbo-goto={s.key} style={`--tab:${s.colour}`}>{s.key}</a>
      ))}
    </nav>

    <div class="book" data-nbo-book>
      <div class="leaf cover-leaf">
        <section class="side front cover" data-page="0" aria-label="front cover">
          <span class="board" style={`clip-path:${boardClip.front};background:#8a3a52`}></span>
          <img src={frontImage.src} srcset={frontImage.srcSet.attribute} sizes="(max-width: 760px) 92vw, 620px" width="1268" height="1834" alt="the front cover of my notebook" style={`clip-path:${coverClip.front}`} loading="lazy" draggable="false" />
        </section>
        <Page n={1} label="inside front cover" class="endpaper">
          <div class="found">
            <p class="small">in case of loss, please return to:</p>
            <p class="line name"><span class="sig" role="img" aria-label="rohanth" set:html={signature} /> marem</p>
            <p class="line"><a href={links.email}>{links.emailText}</a></p>
            <p class="line">cs @ waterloo</p>
          </div>
          <p class="motto">i like to sidequest.</p>
        </Page>
      </div>

      <div class="leaf">
        <Page n={2}>
          <h2 class="title">contents</h2>
          <ol class="toc">
            {sections.map((s) => (
              <li><a href={`#${s.key}`} data-nbo-goto={s.key}><span>{s.key}</span><i></i><span>{s.page}</span></a></li>
            ))}
            <li><a href="#chat" data-nbo-goto="chat"><span>want to chat?</span><i></i><span>15</span></a></li>
          </ol>
          <div class="aside">
            <span class="wide-only">click a page, or use the arrow keys, to turn it.</span>
            <span class="narrow-only">tap or swipe to turn the page.</span>
          </div>
        </Page>
        <Page n={3} section="people" class="dense">
          <h2 class="title">inspiration</h2>
          <p class="lede">people, readings and youtube rabbit-holes that rewired how i think.</p>
          <h3 class="sub">people</h3>
          {people.map((item) => (
            <div class="inspo"><h4><mark>{item.name}</mark></h4><p>{item.why}</p></div>
          ))}
        </Page>
      </div>

      <div class="leaf">
        <Page n={4} section="readings" class="dense">
          <h3 class="sub">readings</h3>
          {readings.slice(0, 2).map((item) => (
            <div class="inspo"><h4><mark>{item.name}</mark> <span class="by">{item.kind} · {item.by}</span></h4><p>{item.why}</p></div>
          ))}
        </Page>
        <Page n={5} class="dense">
          {readings.slice(2).map((item) => (
            <div class="inspo"><h4><mark>{item.name}</mark> <span class="by">{item.kind} · {item.by}</span></h4><p>{item.why}</p></div>
          ))}
        </Page>
      </div>

      <div class="leaf">
        <Page n={6} section="watching">
          <h3 class="sub">watching</h3>
          {media.map((item) => (
            <div class="inspo"><h4><mark>{item.name}</mark> <span class="by">{item.kind}</span></h4><p>{item.why}</p></div>
          ))}
        </Page>
        <Page n={7} section="clippings" class="dense">
          <h3 class="sub">clippings</h3>
          {scripts.map((script, i) => (
            <figure class="clip script" style={`--r:${i % 2 ? 1.5 : -1.2}deg`}>
              {script.fragments.map((fragment) => fragment.map((line) => <p class={`sl sl-${line.kind}`}>{line.text}</p>))}
              <figcaption>{script.href ? <a href={script.href} {...ext}>{script.film}</a> : script.film}{script.year && ` (${script.year})`}</figcaption>
            </figure>
          ))}
        </Page>
      </div>

      <div class="leaf">
        {[notes.slice(0, 2), notes.slice(2)].map((group, g) => (
          <Page n={8 + g} class="dense">
            {group.map((note, i) => (
              <figure class="clip" style={`--r:${[-1, 1.2, -1.6, 0.8][(2 * g + i) % 4]}deg`}>
                <blockquote cite={note.href}>{note.text.map((para, j) => <>{j > 0 && note.elided && <p class="elide">[…]</p>}<p>{para}</p></>)}</blockquote>
                <figcaption>— <a href={note.href} {...ext}>{note.who}</a>{note.source && `, ${note.source}`}{note.via && <> (via <a href={note.via.href} {...ext}>{note.via.who}</a>)</>}</figcaption>
              </figure>
            ))}
          </Page>
        ))}
      </div>

      <div class="leaf">
        {/* left blank, so sidequests opens on a fresh spread */}
        <Page n={10} class="blank" />
        <Page n={11} section="sidequests">
          <h2 class="title">sidequests</h2>
          <p class="lede">things i do for fun, or just because.</p>
          <h3>{quest.ironman.title}</h3>
          <p>{quest.ironman.note}</p>
          <ul class="checks">
            {quest.ironman.objectives.map((o) => <Check done={o.done}>{o.href ? <a href={o.href} {...ext}>{o.text}</a> : o.text}</Check>)}
          </ul>
          <div class="pile run">
            <Snap pic={runStartPhoto} alt="runners crossing under the oakville 21.1 start / finish arch" w={37} r={-3} cap="oakville 21.1" />
            <Snap pic={bikePhoto} alt="the view over my road bike's handlebars down a forest trail" w={24} r={4} cap="on the bike" />
            <Snap pic={signupPhoto} alt="my ironman 70.3 musselman registration page counting down 245 days, next to me grinning on facetime" w={54} r={1.5} cap="signed up for my first 70.3!" class="signup" />
          </div>
        </Page>
      </div>

      <div class="leaf">
        <Page n={12}>
          <h3>{quest.food.title}</h3>
          <p>{quest.food.note}</p>
          <ul class="checks">
            {quest.food.objectives.map((o) => <Check done={o.done}>{o.href ? <a href={o.href} {...ext}>{o.text}</a> : o.text}</Check>)}
          </ul>
          <div class="pile food">
            <Snap pic={katsuPhoto} alt="katsu plates, chopsticks and orange slices from above" w={28} r={-4} cap="katsu" />
            <Snap pic={indianPhoto} alt="an indian dinner spread with naan, curries and rice" w={32} r={3} cap="indian" />
            <Snap pic={udonPhoto} alt="udon and japanese curry rice at a busy counter" w={32} r={-1.5} cap="udon + curry" />
          </div>
        </Page>
        <Page n={13}>
          <h3>{quest.film.title}</h3>
          <p>{quest.film.note}</p>
          <div class="pile photos">
            <Snap pic={dumboPhoto} alt="the manhattan bridge between brick buildings in dumbo" w={28} r={-3} cap="dumbo" />
            <Snap pic={windowPhoto} alt="the new york skyline at dusk through a car window" w={44} r={2.5} cap="nyc, through the window" />
            <Snap pic={concertPhoto} alt="an arena concert from the upper seats, the stage lit orange" w={26} r={2} cap="concert" />
            <Snap pic={sfPhoto} alt="three friends arm in arm on a san francisco street" w={28} r={-2.5} cap="sf" />
          </div>
        </Page>
      </div>

      <div class="leaf">
        <Page n={14}>
          <h3>{quest.wings.title}</h3>
          <p>{quest.wings.note}</p>
          <div class="stamps">
            {quest.wings.stamps?.map((s, i) => <span class="stamp" style={`--r:${[-12, 8, -4][i % 3]}deg`}>{s.label}<svg class="bull" viewBox="0 0 32 24" aria-hidden="true"><path d="M3.5 2.5c.4 4.6 3.4 7 8 7.2M28.5 2.5c-.4 4.6-3.4 7-8 7.2" /><path d="M7.5 9.6 11 11.4M24.5 9.6 21 11.4" /><path d="M11.4 9.7h9.2l-.9 8.6c-.4 2.7-2 3.9-3.7 3.9s-3.3-1.2-3.7-3.9Z" /><path d="M14.2 18.6h.01M17.8 18.6h.01" /></svg></span>)}
          </div>
          <Snap pic={wingsPhoto} alt="me biting into a wing at the dfw airport buffalo wild wings, on film" w={37} r={-2} cap="DFW, on film" class="wings" />
          <div class="karate">
            <div>
              <h3>karate</h3>
              <p>10+ years.<br />2nd degree black belt.</p>
            </div>
            <Snap pic={karateReadyPhoto} alt="me standing ready in a white gi at nationals" w={24} r={-3} />
            <Snap pic={karateJumpPhoto} alt="me mid-air during a jumping kata" w={24} r={2.5} cap="nationals 2026" />
          </div>
        </Page>
        <Page n={15} section="chat" class="chat">
          <h2 class="title">want to chat?</h2>
          <p class="email"><a href={links.email}>{links.emailText}</a></p>
          <ul class="elsewhere">
            <li><a href={links.x} {...ext}>x / twitter<i class="arr up" aria-hidden="true"></i></a></li>
            <li><a href={links.github} {...ext}>github<i class="arr up" aria-hidden="true"></i></a></li>
            <li><a href={links.substack} {...ext}>substack<i class="arr up" aria-hidden="true"></i></a></li>
          </ul>
          <p class="sign" role="img" aria-label="rohanth" set:html={signature} />
        </Page>
      </div>

      <div class="leaf cover-leaf">
        <Page n={16} label="inside back cover" class="endpaper">
          <a class="card" href={links.repo} {...ext}>this site's source<i class="arr up" aria-hidden="true"></i></a>
          <div class="pocket" aria-hidden="true"></div>
        </Page>
        <section class="side back cover" data-page="17" aria-label="back cover" data-nbo-back>
          <span class="board" style={`clip-path:${boardClip.back};background:#6e3242`}></span>
          <img src={backImage.src} srcset={backImage.srcSet.attribute} sizes="(max-width: 760px) 92vw, 620px" width="1268" height="1834" alt="the back cover of my notebook, covered in stickers" style={`clip-path:${coverClip.back}`} loading="lazy" draggable="false" />
          {/* the same pick-up-a-sticker trick as the front cover on the home page (Notebook.astro) */}
          <div class="dim" style={`clip-path:${covers.back.book}`}></div>
          {covers.back.stickers.map((s) => (
            <button type="button" class="sticker" style={`--clip:${s.clip};--origin:${s.origin}`} aria-label={s.name} aria-pressed="false" data-name={s.name} data-note={s.note} data-href={s.href}>
              <span class="hit"></span>
              <span class="lift"><img src={backImage.src} srcset={backImage.srcSet.attribute} sizes="(max-width: 760px) 92vw, 620px" width="1268" height="1834" alt="" loading="lazy" decoding="async" draggable="false" /></span>
            </button>
          ))}
        </section>
      </div>
    </div>
  </div>

  <p class="sticker-caption" data-nbo-caption aria-live="polite"></p>

  <div class="pager" data-nbo-chrome>
    <button type="button" data-nbo-prev aria-label="previous page">←</button>
    <span class="where sr-only" data-nbo-where aria-live="polite">cover</span>
    <button type="button" data-nbo-next aria-label="next page">→</button>
  </div>
</dialog>

<style is:global>
  .nbo {
    --pen: #1d2342;
    --pen-blue: #2b47a8;
    --pen-red: #c2382c;
    --page: #f7f3ea;
    --maroon: #6c2435;
    /* the cover photo's shape; a spread is two of them side by side, with room for the tabs */
    --ph: min(calc(100svh - 150px), calc((100vw - 300px) / 1.3828), 880px);
    --pw: calc(var(--ph) * 0.6914);
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: transparent; color: var(--ink); overflow: hidden;
  }
  .nbo::backdrop { background: transparent; }
  html.nbo-open { overflow: hidden; }
  /* no backdrop blur: blurring the whole page behind every frame of the turn is what made it stutter */
  .nbo .backdrop { position: absolute; inset: 0; background: color-mix(in srgb, var(--paper) 93%, transparent); }

  .nbo .close { position: absolute; z-index: 3; top: 14px; right: 16px; display: grid; place-items: center; width: 48px; height: 48px; color: var(--ink-2); transition: color var(--dur-fast) var(--ease-out); }
  .nbo .close svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .nbo .close:hover { color: var(--ink); }
  .nbo .pager { position: absolute; z-index: 3; left: 50%; bottom: 18px; translate: -50% 0; display: flex; align-items: center; gap: 6px; font: 13px/1 var(--sans); color: var(--ink-2); }
  .nbo .pager button { width: 40px; height: 40px; font-size: 16px; color: var(--ink); transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .nbo .pager button:disabled { opacity: 0.25; }
  .nbo .pager button:active:not(:disabled) { transform: scale(0.92); }

  .nbo .stage:focus { outline: none; }
  .nbo .stage { position: absolute; left: 50%; top: calc(50% - 8px); width: calc(var(--pw) * 2); height: var(--ph); translate: -50% -50%; }

  /* sticky index tabs stuck to the edge of the pages */
  .nbo .tabs { position: absolute; left: 100%; top: 7%; display: flex; flex-direction: column; gap: 10px; transition: opacity 400ms var(--ease-out), translate 400ms var(--ease-out-strong); }
  .nbo .stage.closed .tabs { opacity: 0; translate: -24px 0; pointer-events: none; }
  .nbo .tab { display: block; margin-left: -10px; padding: 9px 16px 9px 20px; font: 500 13px/1 var(--sans); color: var(--pen); background: var(--tab); border-radius: 0 5px 5px 0; box-shadow: 0 1px 2px rgb(0 0 0 / 0.14), inset 8px 0 8px -6px rgb(0 0 0 / 0.16); transition: translate 260ms var(--ease-out-strong); }
  .nbo .tab:hover, .nbo .tab[aria-current="true"] { translate: 8px 0; }

  .nbo .book { position: relative; width: 100%; height: 100%; perspective: 2600px; }
  .nbo .book.closed-front { transform: translateX(-25%); }
  .nbo .book.closed-back { transform: translateX(25%); }
  .nbo .leaf { position: absolute; left: 50%; top: 0; width: 50%; height: 100%; transform-origin: left center; transform-style: preserve-3d; }
  /* no blanket will-change: a turning leaf gets its own layer from its animation, and only then */
  .nbo .side { position: absolute; inset: 0; container-type: size; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .nbo .side.back { transform: rotateY(180deg); }
  /* paper sits just inside the covers */
  .nbo .leaf:not(.cover-leaf) .side { inset: 1.1% 1.3% 1.1% 0; }
  .nbo .side:not(.cover) { box-shadow: 0 1px 1px rgb(0 0 0 / 0.08), 0 14px 30px -12px rgb(30 20 20 / 0.3); }
  .nbo .side:not(.cover)[data-page] { cursor: pointer; }
  .nbo .side.front:not(.cover) { border-radius: 0 6px 6px 0; }
  .nbo .side.back:not(.cover) { border-radius: 6px 0 0 6px; }
  .nbo .cover img { position: absolute; inset: 0; width: 100%; height: 100%; user-select: none; -webkit-user-select: none; filter: drop-shadow(0 18px 24px rgb(30 20 20 / 0.28)); }
  .nbo .side.cover { cursor: pointer; }
  .nbo .cover .board { position: absolute; inset: 0; background: var(--maroon); }

  /* back cover stickers: a picked one keeps the light, everything else on the cover drops back */
  .nbo .cover .dim { position: absolute; inset: 0; z-index: 1; background: rgb(24 16 14 / 0.56); opacity: 0; pointer-events: none; transition: opacity var(--dur) var(--ease-out); }
  .nbo .cover.has-pick .dim { opacity: 1; }
  /* the button is the size of the whole cover and lets clicks through; .hit is its real shape and
     stays put while .lift moves, so a raised sticker can't slide out from under the pointer */
  .nbo .cover .sticker { position: absolute; inset: 0; pointer-events: none; outline: none; -webkit-tap-highlight-color: transparent; }
  .nbo .cover .hit { position: absolute; inset: 0; clip-path: var(--clip); pointer-events: auto; cursor: pointer; }
  .nbo .cover .lift { position: absolute; inset: 0; pointer-events: none; transform-origin: var(--origin); transition: transform 280ms var(--ease-out-strong), filter 200ms var(--ease-out); }
  .nbo .cover .lift img { clip-path: var(--clip); filter: none; }
  .nbo .cover .sticker:is(:focus-visible, [aria-pressed="true"]) { z-index: 2; }
  .nbo .cover .sticker:focus-visible .lift { transform: translateY(-1%) scale(1.03); filter: drop-shadow(0 0 0 var(--accent)) drop-shadow(0 0 3px var(--accent)) drop-shadow(0 10px 12px rgb(20 10 10 / 0.45)); }
  .nbo .cover .sticker[aria-pressed="true"] .lift { transform: translateY(-1.2%) scale(1.06) rotate(-1.5deg); filter: drop-shadow(0 16px 18px rgb(20 10 10 / 0.5)); }
  .nbo .cover .sticker:active .lift { transform: translateY(-0.4%) scale(1.01); }
  @media (hover: hover) {
    .nbo .cover .sticker:has(.hit:hover) { z-index: 2; }
    .nbo .cover .sticker:has(.hit:hover):not([aria-pressed="true"]) .lift { transform: translateY(-1%) scale(1.03); filter: drop-shadow(0 10px 12px rgb(20 10 10 / 0.45)); }
  }
  /* its caption sits beside the closed back cover, bottom-aligned with it */
  .nbo .sticker-caption {
    position: absolute; z-index: 3; margin: 0;
    left: calc(50% + var(--pw) / 2 + 32px); bottom: calc(50% + 8px - var(--ph) / 2);
    width: min(300px, calc(50% - var(--pw) / 2 - 56px));
    font: 13px/1.5 var(--sans); color: var(--ink); overflow-wrap: anywhere;
