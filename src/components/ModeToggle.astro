---
// The light/dark switch: a moon by day, a sun at night. Base's head script does the switching.
interface Props { class?: string }
const { class: extra } = Astro.props;
---
<button type="button" class:list={["mode-toggle", extra]} data-mode-toggle>
  <svg class="to-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
  <svg class="to-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
  <span class="sr-only"><span class="to-dark">dark mode</span><span class="to-light">light mode</span></span>
</button>

<style>
  .mode-toggle { display: inline-grid; place-items: center; width: 32px; height: 32px; margin: -6px; color: inherit; transition: color var(--dur-fast) var(--ease-out); }
  .mode-toggle:hover { color: var(--accent); }
  svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
</style>
