---
// A hand-drawn checkbox, ticked when it's done.
interface Props { done?: boolean }
const { done = false } = Astro.props;
---
<li class:list={["check", done && "done"]}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path class="box" d="M4.5 5.2c4.8-.6 9.6-.5 14.6-.2.4 4.6.3 9.3-.1 14.1-4.9.4-9.7.5-14.3.1-.5-4.6-.6-9.3-.2-14Z" />{done && <path class="tick" d="M6.5 12.5c1.6 1.4 2.9 3 3.9 4.8C13 11.6 16.5 6.8 21.5 2.5" />}</svg>
  <span class="sr-only">{done ? "done: " : "to do: "}</span><span><slot /></span>
</li>
